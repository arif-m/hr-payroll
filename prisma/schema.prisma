generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Division {
  id           Int      @id @default(autoincrement())
  createdBy    String   @db.VarChar(100)
  updatedBy    String   @db.VarChar(100)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now())
  divisionName String   @unique @db.VarChar(150)
  divisions    Users[]
  divisionOvertime      RequestOvertimeHeader[]

  @@map("division")
}

model JobTitle {
  id           Int      @id @default(autoincrement())
  createdBy    String   @db.VarChar(100)
  updatedBy    String   @db.VarChar(100)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now())
  jobTitleName String   @unique @db.VarChar(150)
  jobTitles    Users[]

  @@map("jobTitle")
}

model BusinessUnit {
  id               Int      @id @default(autoincrement())
  createdBy        String   @db.VarChar(100)
  updatedBy        String   @db.VarChar(100)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now())
  businessUnitName String   @unique @db.VarChar(150)
  companyName      String?  @db.VarChar(300)
  image            String?  @db.VarChar(300)
  BusinessUnits    Users[]
  attendanceMode   String   @default("EXCEPTION") @db.VarChar(10)
  defaultShiftId   Int?
  defaultShift     Shift?   @relation(fields: [defaultShiftId], references: [id])

  @@map("businessUnit")
}

/// Shift kerja untuk unit/karyawan mode PRESENCE (pabrik).
/// crossesMidnight = shift malam (contoh 22:00 -> 06:00 besoknya).
model Shift {
  id              Int      @id @default(autoincrement())
  uuid            String   @unique @default(uuid()) @db.VarChar(150)
  createdBy       String   @db.VarChar(100)
  updatedBy       String   @db.VarChar(100)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  shiftName       String   @unique @db.VarChar(150)
  startTime       DateTime @db.Time(0)
  endTime         DateTime @db.Time(0)
  crossesMidnight Int      @default(0) @db.TinyInt
  graceMinutes    Int      @default(10)
  businessUnits   BusinessUnit[]
  employeeShifts  EmployeeShift[]
  timeAttendances TimeAttendance[]

  @@map("shift")
}

/// Penugasan shift per karyawan dengan riwayat effectiveFrom.
/// Resolusi shift untuk tanggal D: penugasan efektif terbaru <= D;
/// fallback: BusinessUnit.defaultShift.
model EmployeeShift {
  id            Int      @id @default(autoincrement())
  uuid          String   @unique @default(uuid()) @db.VarChar(150)
  createdBy     String   @db.VarChar(100)
  updatedBy     String   @db.VarChar(100)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  employeeId    Int
  shiftId       Int
  effectiveFrom DateTime @db.Date
  employee      Users    @relation(fields: [employeeId], references: [id])
  shift         Shift    @relation(fields: [shiftId], references: [id])

  @@unique([employeeId, effectiveFrom], map: "employeeShift_employee_effectiveFrom_unique")
  @@index([employeeId], map: "employeeShift_employeeId_fkey")
  @@index([shiftId], map: "employeeShift_shiftId_fkey")
  @@map("employeeShift")
}

model Roles {
  id        Int                @id @default(autoincrement())
  uuid      String             @unique @default(uuid()) @db.VarChar(60)
  createdBy String             @db.VarChar(100)
  updatedBy String             @db.VarChar(100)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @default(now())
  roleName  String             @unique @db.VarChar(150)
  role2     ModulePermission[]
  role      Users[]

  @@map("roles")
}

model Ptkp {
  id          Int      @id @default(autoincrement())
  createdBy   String   @db.VarChar(100)
  updatedBy   String   @db.VarChar(100)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  code        String   @unique @db.VarChar(5)
  description String?  @db.VarChar(150)
  amount      Decimal? @db.Decimal(15, 2)
  ptkp2       Users[]

  @@map("ptkp")
}

model Pkp {
  id                Int      @id @default(autoincrement())
  createdBy         String   @db.VarChar(100)
  updatedBy         String   @db.VarChar(100)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  code              String   @unique @db.VarChar(10)
  description       String?  @db.VarChar(350)
  startSalary       Decimal  @db.Decimal(18, 2)
  endSalary         Decimal  @db.Decimal(18, 2)
  ratesPercentage   Decimal  @db.Decimal(5, 2)

  @@map("pkp")
}

model Users {
  id                         Int                   @id @default(autoincrement())
  uuid                       String                @unique @default(uuid()) @db.VarChar(150)
  createdBy                  String                @db.VarChar(100)
  updatedBy                  String                @db.VarChar(100)
  createdAt                  DateTime              @default(now()) @map("created_at")
  updatedAt                  DateTime              @updatedAt @map("updated_at")
  employeeId                 BigInt                @unique
  status                     users_status          @default(Active)
  roleId                     Int
  assignDate                 DateTime?             @db.Date
  assignBy                   String?               @db.VarChar(150)
  fullName                   String                @db.VarChar(150)
  joinDate                   DateTime              @db.Date
  email                      String                @unique @db.VarChar(150)
  mobilePhone                String?               @db.VarChar(20)
  dob                        DateTime              @db.Date
  placeOfBirth               String                @db.VarChar(150)
  personalIdType             String?               @db.VarChar(25)
  personalIdNumber           String?               @db.VarChar(150)
  address                    String                @db.VarChar(150)
  employmentStatus           EmployementStatus?    @default(Probation)
  businessUnitId             Int
  divisionId                 Int
  jobTitleId                 Int
  basicSalary                Decimal?              @db.Decimal(15, 2)
  npwp                       String?               @db.VarChar(150)
  bankName                   String?               @db.VarChar(50)
  bankAccountNumber          String?               @db.VarChar(50)
  bankAccountHolder          String?               @db.VarChar(150)
  password                   String                @db.VarChar(150)
  salt                       String                @db.VarChar(150)
  annualLeave                Int?                  @default(0)
  annualLeaveBalance         Int?                  @default(0)
  sickLeave                  Int?                  @default(0)
  sickLeaveBalance           Int?                  @default(0)
  promoteDate                DateTime?             @db.Date
  supervisor                 Int
  ptkpId                     Int
  salaryTemplateHeaderId     Int?
  is_using_bjps_tenaga_kerja Int?                  @default(1)  @db.TinyInt
  is_using_bjps_kesehatan    Int?                  @default(0)  @db.TinyInt
  businessUnit               BusinessUnit          @relation(fields: [businessUnitId], references: [id])
  division                   Division              @relation(fields: [divisionId], references: [id])
  jobTitle                   JobTitle              @relation(fields: [jobTitleId], references: [id])
  ptkp                       Ptkp                  @relation(fields: [ptkpId], references: [id])
  role                       Roles                 @relation(fields: [roleId], references: [id])
  salaryTemplate             SalaryTemplateHeader? @relation(fields: [salaryTemplateHeaderId], references: [id])
  medicalReimbursementBudget Float                 @default(0)  @db.Float
  medicalReimbursementTaken  Float                 @default(0)  @db.Float
  medicalReimbursementRemaining       Float                 @default(0)  @db.Float
  verificationCode           String?               @db.VarChar(350)     @unique
  provider                   String?               @db.VarChar(350)
  passwordResetToken         String?               @db.VarChar(100)
  passwordResetAt            DateTime?
  image                      String?               @db.VarChar(350)
  payrollPeriod              String                @db.VarChar(7)       @default("Monthly")
  user4                      AdminManagement[]
  user                       EmployeeAnnualLeave[]
  user2                      EmployeeSickLeave[]
  user3                      RequestLeave[]
  user5                      UsersSalary[]
  user6                      PayslipHeader[]
  userRequestLeaveOther      RequestOtherLeave[]
  userRequestMedicalReimbursement      RequestMedicalReimbursementHeader[]
  userTimeAttendance         TimeAttendance[]
  employeeShifts             EmployeeShift[]
  userRequestOvertime        RequestOvertimeDetails[] 
  employmentHistories        EmploymentHistory[]

  @@unique([email, verificationCode, passwordResetToken])
  @@index([businessUnitId], map: "users_businessUnitId_fkey")
  @@index([divisionId], map: "users_divisionId_fkey")
  @@index([jobTitleId], map: "users_jobTitleId_fkey")
  @@index([ptkpId], map: "users_ptkpId_fkey")
  @@index([roleId], map: "users_roleId_fkey")
  @@index([salaryTemplateHeaderId], map: "users_salaryTemplateHeaderId_fkey")
  @@map("users")
}

model Module {
  id          Int                @id @default(autoincrement())
  uuid        String             @unique @default(uuid()) @db.VarChar(60)
  createdBy   String             @db.VarChar(100)
  updatedBy   String             @db.VarChar(100)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @default(now())
  feature     String             @unique @db.VarChar(150)
  description String?            @db.VarChar(300)
  uri         String             @db.VarChar(300)
  parentId    Int                @default(0)
  treeStatus  String             @default("H") @db.VarChar(1)
  icon        String?            @db.VarChar(100)
  isVisible   Int                @default(1) @db.TinyInt
  sequence    Int?
  modul       ModulePermission[]

  @@map("module")
}

model ModulePermission {
  id            Int      @id @default(autoincrement())
  uuid          String   @unique @default(uuid()) @db.VarChar(60)
  createdBy     String   @db.VarChar(100)
  updatedBy     String   @db.VarChar(100)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now())
  modulId       Int
  roleId        Int
  createRight   Int      @default(0) @db.TinyInt
  readRight     Int      @default(1) @db.TinyInt
  updateRight   Int      @default(0) @db.TinyInt
  deleteRight   Int      @default(0) @db.TinyInt
  inactiveRight Int      @default(0) @db.TinyInt
  module        Module   @relation(fields: [modulId], references: [id])
  role          Roles    @relation(fields: [roleId], references: [id])

  @@index([modulId], map: "modulePermission_modulId_fkey")
  @@index([roleId], map: "modulePermission_roleId_fkey")
  @@map("modulePermission")
}

model AdminManagement {
  id         Int      @id @default(autoincrement())
  uuid       String   @unique @default(uuid()) @db.VarChar(150)
  createdBy  String   @db.VarChar(100)
  updatedBy  String   @db.VarChar(100)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now())
  employeeId Int
  role       String   @db.VarChar(100)
  assignDate DateTime @db.Date
  assignBy   String?  @db.VarChar(150)
  fullName   Users    @relation(fields: [employeeId], references: [id])

  @@index([employeeId], map: "adminManagement_employeeId_fkey")
  @@map("adminManagement")
}

model SetupAnnualLeave {
  id                 Int          @id @default(autoincrement())
  uuid               String       @unique @default(uuid()) @db.VarChar(150)
  createdBy          String       @db.VarChar(100)
  updatedBy          String       @db.VarChar(100)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @default(now())
  name               String?      @unique @db.VarChar(150)
  timeOffPerMonth    Int
  timeOffPerYear     Int?
  additionalTimeOff  Int
  defaultCalculation GenerateType @default(Monthly)

  @@map("setupAnnualLeave")
}

model SetupSickLeave {
  id                 Int                               @id @default(autoincrement())
  uuid               String                            @unique @default(uuid()) @db.VarChar(150)
  createdBy          String                            @db.VarChar(100)
  updatedBy          String                            @db.VarChar(100)
  createdAt          DateTime                          @default(now())
  updatedAt          DateTime                          @default(now())
  name               String?                           @unique @db.VarChar(150)
  day                Int
  defaultCalculation setupSickLeave_defaultCalculation @default(Monthly)

  @@map("setupSickLeave")
}

model EmployeeAnnualLeave {
  id         Int      @id @default(autoincrement())
  uuid       String   @unique @default(uuid()) @db.VarChar(150)
  createdBy  String   @db.VarChar(100)
  updatedBy  String   @db.VarChar(100)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now())
  employeeId Int
  Period     Int
  year       Int
  day        Int      @default(1) @db.TinyInt
  remarks    String   @db.VarChar(200)
  fullName   Users    @relation(fields: [employeeId], references: [id])

  @@index([employeeId], map: "employeeAnnualLeave_employeeId_fkey")
  @@map("employeeAnnualLeave")
}

model EmployeeSickLeave {
  id         Int      @id @default(autoincrement())
  uuid       String   @unique @default(uuid()) @db.VarChar(150)
  createdBy  String   @db.VarChar(100)
  updatedBy  String   @db.VarChar(100)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now())
  employeeId Int
  Period     Int
  year       Int
  day        Int      @default(1) @db.TinyInt
  remarks    String   @db.VarChar(200)
  fullName   Users    @relation(fields: [employeeId], references: [id])

  @@index([employeeId], map: "employeeSickLeave_employeeId_fkey")
  @@map("employeeSickLeave")
}

model LeaveType {
  id                   Int        @id @default(autoincrement())
  uuid                 String     @unique @default(uuid()) @db.VarChar(150)
  createdBy            String     @db.VarChar(100)
  updatedBy            String     @db.VarChar(100)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @default(now())
  description          String     @unique @db.VarChar(150)
  day                  Int        @default(1) @db.TinyInt
  allowToOverrideLimit Int        @default(0) @db.TinyInt
  status               StatusUser @default(Active)
  requestLeaves        RequestLeave[] @relation("RLToLeaveType")

  @@map("leaveType")
}

model RequestLeave {
  id                   Int       @id @default(autoincrement())
  uuid                 String    @unique @default(uuid()) @db.VarChar(150)
  createdBy            String    @db.VarChar(100)
  updatedBy            String    @db.VarChar(100)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @default(now())
  leaveType            Int
  leaveTypeDescription String    @db.VarChar(150)
  startDuration        DateTime  @db.DateTime(0)
  endDuration          DateTime  @db.DateTime(0)
  days                 Decimal   @db.Decimal(5, 2)
  leaveDescription     String    @db.VarChar(300)
  employeeId           Int
  businessUnitId       Int?
  businessUnitName     String?   @db.VarChar(150)
  divisionId           Int?
  divisionName         String?   @db.VarChar(150)
  jobTitleId           Int?
  jobTitleName         String?   @db.VarChar(150)
  isApproved           Int       @default(0) @db.TinyInt
  approvedBy           String?   @db.VarChar(150)
  approvedDate         DateTime? @db.DateTime(0)
  commentsBySupervisor String?   @db.VarChar(300)
  fullName             Users     @relation(fields: [employeeId], references: [id])
  leaveTypeRef         LeaveType @relation("RLToLeaveType", fields: [leaveType], references: [id])
  image                String?   @db.VarChar(300)
  isApprovedByHR       Int       @default(0)           @db.TinyInt
  approvedHRBy         String?   @db.VarChar(150)
  approvedDateByHR     DateTime? @db.DateTime(0)
  commentsByHR         String?   @db.VarChar(300)

  @@index([employeeId], map: "requestLeave_employeeId_fkey")
  @@index([leaveType], map: "requestLeave_leaveType_fkey")
  @@map("requestLeave")
}

model SetupSystem {
  id                   Int                   @id @default(autoincrement())
  uuid                 String                @unique @default(uuid()) @db.VarChar(150)
  createdBy            String                @db.VarChar(100)
  updatedBy            String                @db.VarChar(100)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @default(now())
  workDays             Int
  workHours            Int
  workStart            DateTime              @db.Time(0)
  workEnd              DateTime              @db.Time(0)
  defaultTaxMethod     DefaultTaxMethod?     @default(GrossUp)
  taxRegime            TaxRegime?            @default(TER)
  taxCalculationMethod TaxCalculationMethod? @default(Standard)
  taxPercentage        Decimal?              @db.Decimal(5, 2) @default(5)
  biayaJabatanMaxMonthly Decimal             @db.Decimal(15, 2) @default(500000)
  npwpSurchargePct     Decimal               @db.Decimal(5, 2) @default(20)
  isActivatePercentageMedicalReimbursement   Int       @default(0) @db.TinyInt
  thrBudgetBaseCodes   String    @default("BS") @db.VarChar(150)
  thrEligibilityMonths Int       @default(1)
  thrProrateRoundDays  Int       @default(1) @db.TinyInt
  // --- Fase 2: sanksi keterlambatan (mode PRESENCE) ---
  latePenaltyEnabled   Int       @default(0) @db.TinyInt
  latePenaltyBaseCodes String    @default("BS") @db.VarChar(150)
  latePenaltyTiers     Json?
  latePenaltyEscalation Json?


  @@map("setupSystem")
}

model SetupCalendar {
  id          Int      @id @default(autoincrement())
  uuid        String   @unique @default(uuid()) @db.VarChar(150)
  createdBy   String   @db.VarChar(100)
  updatedBy   String   @db.VarChar(100)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())
  eventDate   DateTime @db.Date
  eventName   String   @db.VarChar(300)
  description String?  @db.Text
  is_workdays Int      @default(0) @db.TinyInt

  @@map("setupCalendar")
}

model SalaryComponentType {
  id                   Int               @id @default(autoincrement())
  uuid                 String            @unique @default(uuid()) @db.VarChar(150)
  createdBy            String            @db.VarChar(100)
  updatedBy            String            @db.VarChar(100)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @default(now())
  componentType        String            @db.VarChar(150)
  isActive             Int               @default(1) @db.TinyInt

  salaryComponentTypes    SalaryComponent[]
  salaryComponentTypes2   UsersSalary[]
  @@map("salaryComponentType")
}

model SalaryComponentCategory {
  id                       Int               @id @default(autoincrement())
  uuid                     String            @unique @default(uuid()) @db.VarChar(150)
  createdBy                String            @db.VarChar(100)
  updatedBy                String            @db.VarChar(100)
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @default(now())
  componentCategory        String            @db.VarChar(150)
  isActive                 Int               @default(1) @db.TinyInt

  salaryComponentCategories SalaryComponent[]
  salaryComponentCategories2 UsersSalary[]
  @@map("salaryComponentCategory")
}

model SalaryComponent {
  id                        Int                     @id @default(autoincrement())
  uuid                      String                  @unique @default(uuid()) @db.VarChar(150)
  createdBy                 String                  @db.VarChar(100)
  updatedBy                 String                  @db.VarChar(100)
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @default(now())
  componentCode             String                  @unique @db.VarChar(30)
  componentName             String                  @db.VarChar(250)
  salaryComponentTypeId     Int
  salaryComponentCategoryId Int
  isTaxable                 Int                     @default(0) @db.TinyInt
  isActive                  Int                     @default(1) @db.TinyInt
  sequence                  Int?
  isTakeHomePay             Int                     @default(0) @db.TinyInt
  componentCategories       SalaryComponentCategory @relation(fields: [salaryComponentCategoryId], references: [id])
  componentTypes            SalaryComponentType     @relation(fields: [salaryComponentTypeId], references: [id])
  salaryComponents          SalaryTemplateDetails[]

  @@index([salaryComponentCategoryId], map: "salaryComponent_salaryComponentCategoryId_fkey")
  @@index([salaryComponentTypeId], map: "salaryComponent_salaryComponentTypeId_fkey")
  @@map("salaryComponent")
}

model SalaryTemplateHeader {
  id              Int                              @id @default(autoincrement())
  uuid            String                           @unique @default(uuid()) @db.VarChar(150)
  createdBy       String                           @db.VarChar(100)
  updatedBy       String                           @db.VarChar(100)
  createdAt       DateTime                         @default(now())
