/// Satu siklus proses payroll untuk satu periode cut-off:
/// DRAFT → SUBMITTED → APPROVED → LOCKED.
/// Payslip hanya bisa digenerate/dikoreksi saat run berstatus DRAFT;
/// LOCKED = final (siap laporan & pembayaran).
model PayrollRun {
  id                Int                @id @default(autoincrement())
  uuid              String             @unique @default(uuid()) @db.VarChar(150)
  createdBy         String             @db.VarChar(100)
  updatedBy         String             @db.VarChar(100)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  cutOffPeriodId    Int
  cutOffPeriod      CutOffPeriod       @relation(fields: [cutOffPeriodId], references: [id])
  status            PayrollRunStatus   @default(DRAFT)
  submittedBy       String?            @db.VarChar(100)
  submittedAt       DateTime?
  approvedBy        String?            @db.VarChar(100)
  approvedAt        DateTime?
  lockedBy          String?            @db.VarChar(100)
  lockedAt          DateTime?
  taxConfigSnapshot Json?
  note              String?            @db.VarChar(300)
  runDetail         PayrollRunDetail[]
  payslips          PayslipHeader[]

  @@unique([cutOffPeriodId])
  @@map("payrollRun")
}

/// Ringkasan hasil generate per karyawan dalam satu run (audit ringkas
/// tanpa membuka payslip): status OK/FAILED, bruto, potongan, THP, PPh 21.
model PayrollRunDetail {
  id              Int         @id @default(autoincrement())
  createdBy       String      @db.VarChar(100)
  updatedBy       String      @db.VarChar(100)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  payrollRunId    Int
  payrollRun      PayrollRun  @relation(fields: [payrollRunId], references: [id])
  usersId         Int
  fullName        String      @db.VarChar(150)
  status          String      @db.VarChar(20) @default("OK")
  errorMessage    String?     @db.VarChar(300)
  grossAmount     Decimal     @default(0) @db.Decimal(15, 2)
  deductionAmount Decimal     @default(0) @db.Decimal(15, 2)
  thpAmount       Decimal     @default(0) @db.Decimal(15, 2)
  pph21Amount     Decimal     @default(0) @db.Decimal(15, 2)

  @@unique([payrollRunId, usersId])
  @@index([usersId])
  @@map("payrollRunDetail")
}

