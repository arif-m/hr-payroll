  salaryComponentId Int
  formula           String?              @db.VarChar(300)
  amount            Decimal?             @db.Decimal(15, 2)
  component         SalaryComponent      @relation(fields: [salaryComponentId], references: [id])
  template          SalaryTemplateHeader @relation(fields: [salaryTemplateId], references: [id])

  @@index([salaryComponentId], map: "salaryTemplateDetails_salaryComponentId_fkey")
  @@index([salaryTemplateId], map: "salaryTemplateDetails_salaryTemplateId_fkey")
  @@map("salaryTemplateDetails")
}

model UsersSalary {
