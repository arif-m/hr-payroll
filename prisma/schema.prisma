  updatedAt     DateTime @default(now())
  isActive      Int      @default(1) @db.TinyInt
  componentCode String   @unique @db.VarChar(250)
  componentName String   @db.VarChar(250)
  percentage    Decimal? @default(0) @db.Decimal(5, 2)
  minimumWages  Decimal? @default(0) @db.Decimal(15, 2)
  maximumWages  Decimal? @default(0) @db.Decimal(15, 2)
  formula       String?  @db.VarChar(300)
  sequence      Int?
  isTakeHomePay Int      @default(0) @db.TinyInt

  @@map("bpjsTenagaKerjaComponent")
}

model TemplateBpjsTenagaKerjaHeader {
  id             Int                              @id @default(autoincrement())
  uuid           String                           @unique @default(uuid()) @db.VarChar(150)
  createdBy      String                           @db.VarChar(100)
  updatedBy      String                           @db.VarChar(100)
  createdAt      DateTime                         @default(now())
  updatedAt      DateTime                         @default(now())
  isActive       Int                              @default(1) @db.TinyInt
  templateName   String                           @db.VarChar(250)
  templateBpjsTK TemplateBpjsTenagaKerjaDetails[]

  @@map("templateBpjsTenagaKerjaHeader")
}

model TemplateBpjsTenagaKerjaDetails {
  id                        Int                           @id @default(autoincrement())
  uuid                      String                        @unique @default(uuid()) @db.VarChar(150)
  createdBy                 String                        @db.VarChar(100)
  updatedBy                 String                        @db.VarChar(100)
  createdAt                 DateTime                      @default(now())
  updatedAt                 DateTime                      @default(now())
  salaryTemplateId          Int
  bpjsTenagaKerjaTemplateId Int
  componentId               Int
  componentCode             String                        @db.VarChar(250)
  componentName             String                        @db.VarChar(250)
  percentage                Decimal?                      @default(0) @db.Decimal(5, 2)
  minimumWages              Decimal?                      @default(0) @db.Decimal(15, 2)
  maximumWages              Decimal?                      @default(0) @db.Decimal(15, 2)
  formula                   String?                       @db.VarChar(300)
  sequence                  Int?
  isTakeHomePay             Int                           @default(0) @db.TinyInt
