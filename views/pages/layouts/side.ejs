<aside class="navbar navbar-vertical navbar-expand-lg navbar-dark">
  <div class="container-fluid">
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbar-menu">
      <span class="navbar-toggler-icon"></span>
    </button>
    <h1 class="navbar-brand navbar-brand-autodark">
      <!--<a href=".">
        <img src="/images/meme.png" width="210" height="32" alt="Payroll" class="navbar-brand-image">
      </a>--> HR Payroll
    </h1>
    
    <div class="collapse navbar-collapse" id="navbar-menu">
      <ul class="navbar-nav pt-lg-3">
        <% if (getRoles.status == true) { %>
          <% getRoles.data.forEach(function(data) { %>
            <% if (data.uri == '#') { %>
              <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle" href="#navbar-base" data-bs-toggle="dropdown" data-bs-auto-close="false" role="button" aria-expanded="false" >
                  <span class="nav-link-icon d-md-none d-lg-inline-block">
                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><polyline points="12 3 20 7.5 20 16.5 12 21 4 16.5 4 7.5 12 3" /><line x1="12" y1="12" x2="20" y2="7.5" /><line x1="12" y1="12" x2="12" y2="21" /><line x1="12" y1="12" x2="4" y2="7.5" /><line x1="16" y1="5.25" x2="8" y2="9.75" /></svg>
                  </span>
                  <span class="nav-link-title">
                    <%= data.feature %>
                  </span>
                </a>
                <% if (data.children) { %>
                  <div class="dropdown-menu">
                    <div class="dropdown-menu-columns">
                      <div class="dropdown-menu-column">
                        <% data.children.forEach(function(dataChildren) { %>
                          <% if (dataChildren.uri == '#' && dataChildren.children && dataChildren.children.length > 0) { %>
                            <div class="dropend">
                              <a class="dropdown-item dropdown-toggle" href="#sub-<%= dataChildren.id %>" data-bs-toggle="dropdown" data-bs-auto-close="false" role="button" aria-expanded="false">
                                <%= dataChildren.feature %>
                              </a>
                              <div class="dropdown-menu">
                                <% dataChildren.children.forEach(function(sub) { %>
                                  <a class="dropdown-item" href="<%= sub.uri %>"><%= sub.feature %></a>
                                <% }); %>
                              </div>
                            </div>
                          <% } else { %>
                            <a class="dropdown-item" href="<%= dataChildren.uri %>" >
                              <%= dataChildren.feature %>
                            </a>
                          <% } %>
                        <% }) %>
                      </div>                    
                    </div>
                  </div>
                <% } %>
              </li>
            <% } else { %>   
              <li class="nav-item">
                <a class="nav-link" href="<%= data.uri %>" >
                  <span class="nav-link-icon d-md-none d-lg-inline-block">
                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><polyline points="5 12 3 12 12 3 21 12 19 12" /><path d="M5 12v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-7" /><path d="M9 21v-6a2 2 0 0 1 2 -2h2a2 2 0 0 1 2 2v6" /></svg>
                  </span>
                  <span class="nav-link-title">
                    <%= data.feature %>
                  </span>
                </a>
              </li>
            <% } %>   
          <% }); %>     
        <% } else { %>   
        Module Permissions have no data 
        <% } %>   
      </ul>
    </div>
  </div>
</aside>

