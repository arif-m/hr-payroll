<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('./../layouts/head'); %>
</head>
<body>  
  <div class="page">
    <aside class="navbar navbar-vertical navbar-expand-lg navbar-dark">
      <%- include('./../layouts/side'); %>
    </aside>
    <%- include('./../layouts/header1'); %>
  
    <div class="page-wrapper">
      <div class="container-xl">
        <%- include('./../layouts/header2'); %>
      </div>
      <div class="page-body">
        <div class="container-xl">
          <div class="row row-deck row-cards">
            <div class="col-12">
              <div class="card">
                  <div class="card-header">
                    <h3 class="card-title">Data Listing</h3>
                  </div>
                  <div class="card-body border-bottom py-3">
                    <div class="col-12 mb-3">
                      <button class="btn btn-outline-primary ms-auto" data-bs-toggle="modal" data-bs-target="#modal-add">Add</button><br />
                    </div>
                    <form action="/medical-reimbursement-category" id="frmSearch" type="GET">
                      <div class="d-flex">
                        <div class="text-muted">
                        Show
                        <div class="mx-2 d-inline-block">
                            <input type="text" class="form-control form-control-sm" value="<%= listOfMedicalReimbursementCategory.meta.limit %>" size="3" aria-label="data count">
                        </div>
                        entries
                        </div>
                        <div class="ms-auto text-muted">
                          <div class="input-group mb-2">
                            <input type="text" id="search" name="search" class="form-control form-control-sm" placeholder="search data" value="<% if(locals.search) { %><%= search  %><% } %>">
                            <button class="btn" type="submit">Go</button>
                          </div>
                        </div>
                    </form>
                  </div>

                  <div class="table-responsive">
                    <table class="table card-table table-vcenter text-nowrap datatable" id="mytable">
                      <thead>
                      <tr>
                        <th class="w-1">Id. <!-- Download SVG icon from http://tabler-icons.io/i/chevron-up -->
                          <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-sm text-dark icon-thick" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><polyline points="6 15 12 9 18 15" /></svg>
                        </th>
                        <th>Description</th>
                        <th>Percentage</th>
                        <th></th>
                      </tr>
                      </thead>
                      <tbody>
                        <% listOfMedicalReimbursementCategory.data.forEach(function(data) { %>
                          <tr>
                              <td><span class="text-muted"><%= data.id %></span></td>
                              <td><%= data.description %></td>
                              <td><%= data.percentage %></td>
                              <td class="text-end">
                                <button class="btn btn-outline-primary ms-auto edit" data-bs-toggle="modal" data-bs-target="#modal-edit" data-id="<%= data.id %>" data-description="<%= data.description %>" data-percentage="<%= data.percentage %>" data-is_active="<%= data.isActive %>">Edit</button>
                              </td>
                          </tr>
                          <% }); %>                     
                      </tbody>
                    </table>
                  </div>
                                    
                  <div class="card-footer d-flex align-items-center">
                    <p class="m-0 text-muted">Showing <span>1</span> to <span><%= listOfMedicalReimbursementCategory.meta.totalRecordCurrentPage %></span> of <span><%= listOfMedicalReimbursementCategory.meta.totalRecords %></span> entries</p>
                    <% if (listOfMedicalReimbursementCategory.meta.totalPage > 1) { %>
                    <ul class="pagination m-0 ms-auto">
                      <% if (listOfMedicalReimbursementCategory.meta.currentPage == 0) { %>
                        <li class="page-item  disabled"><a class="btn btn-outline-primary ms-auto disabled btn-sm"><< First</a></li>&nbsp;
                      <% } else { %>
                          <li class="page-item"><a class="btn btn-outline-primary ms-auto inactive btn-sm" href="/medical-reimbursement-category?page=0&limit=<%= listOfMedicalReimbursementCategory.meta.limit %>"><< First</a></li>&nbsp;
                      <% } %>
                      
                      <% if (listOfMedicalReimbursementCategory.meta.currentPage == 0) { %>
                        <li class="page-item  disabled"><a class="btn btn-outline-primary ms-auto disabled btn-sm">< Prev</a></li>&nbsp;
                      <% } else { %>
                          <li class="page-item"><a class="btn btn-outline-primary ms-auto inactive btn-sm" href="/medical-reimbursement-category?page=<%= listOfMedicalReimbursementCategory.meta.currentPage-1 %>&limit=<%= listOfMedicalReimbursementCategory.meta.limit %>">< Previous</a></li>&nbsp;
                      <% } %>
  
                      <% if ((listOfMedicalReimbursementCategory.meta.currentPage + 1) == listOfMedicalReimbursementCategory.meta.totalPage) { %>
                        <li class="page-item  disabled"><a class="btn btn-outline-primary ms-auto disabled btn-sm">Next ></Next></a></li>&nbsp;
                      <% } else { %>
                          <li class="page-item"><a class="btn btn-outline-primary ms-auto inactive btn-sm" href="/medical-reimbursement-category?page=<%= listOfMedicalReimbursementCategory.meta.currentPage+1 %>&limit=<%= listOfMedicalReimbursementCategory.meta.limit %>"> Next ></a></li>&nbsp;
                      <% } %>
  
                      <% if (listOfMedicalReimbursementCategory.meta.currentPage == (listOfMedicalReimbursementCategory.meta.totalPage-1)) { %>
                        <li class="disabled"><a class="btn btn-outline-primary ms-auto disabled btn-sm">Last >></a></li>&nbsp;
                      <% } else { %>
                          <li><a class="btn btn-outline-primary ms-auto inactive btn-sm" href="/medical-reimbursement-category?page=<%= listOfMedicalReimbursementCategory.meta.totalPage - 1 %>&limit=<%= listOfMedicalReimbursementCategory.meta.limit %>">Last >></a></li>
                      <% } %>
                    </ul>
                    <% } %>
                  </div> 
              </div>
            </div>
          </div>
        </div>
      </div>
      <footer class="footer footer-transparent d-print-none">
        <%- include('./../layouts/footer'); %>
      </footer>
    </div>
  </div>
  
  <div class="modal modal-blur fade" id="modal-add" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">New Medical Reimbursement Category</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <form class="card card-md" method="POST" action="/medical-reimbursement-category" autocomplete="off">
          <div class="modal-body">
            <div class="mb-3">
              <label class="form-label">Description</label>
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="text" class="form-control" name="description" id="description" placeholder="Description of medical reimbursement category" required>
            </div>          
            <div class="mb-3">
                <label class="form-label">Percentage</label>
                <input type="number" class="form-control" name="percentage" id="percentage" placeholder="Percentage of category" min="0" required>
            </div>          
          </div>
        
          <div class="modal-footer">
            <button type="button" class="btn me-auto" data-bs-dismiss="modal">Close</button>
            <button class="btn btn-primary ms-auto" type="submit">
              Insert Data
            </button>
          </div>
        </form>
    </div>
    </div>
  </div>

  <div class="modal modal-blur fade" id="modal-edit" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Edit Medical Reimbursement Category</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <form id="frmEdit" class="card card-md" method="POST" action="/medical-reimbursement-category/update"  autocomplete="off">
          <div class="modal-body">
            <div class="mb-3">
              <label class="form-label">Description</label>
              <input type="hidden" name="id" id="id" class="id" >
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="text" class="form-control description" name="description" id="description" placeholder="Description of medical reimbursement category" required>
            </div>   
            <div class="mb-3">
                <label class="form-label">Percentage</label>
                <input type="number" class="form-control percentage" name="percentage" id="percentage" placeholder="Percentage of category" min="0" required>
            </div>                 
            <div class="col-mb-3">
              <label class="form-label col-3 col-form-label" for="is_taxable">Is Active ?</label>
              <div class="col-9">
                <input type="hidden" class="form-control is-active" name="is_active" id="is_active">
                <input type="checkbox" class="chk-is-active" id="chk_is_active" name="chk_is_active" >
              </div>
            </div>  
          </div>

          <div class="modal-footer">
            <button type="button" class="btn me-auto" data-bs-dismiss="modal">Close</button>
            <button id="updateBtn" class="btn btn-primary ms-auto" type="submit">
              Update Data
            </button>
          </div>
        </form>
    </div>
    </div>
  </div>
  
  <div class="modal modal-blur fade" id="modal-error" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-sm modal-dialog-centered" role="document">
      <div class="modal-content">
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        <div class="modal-status bg-danger"></div>
        <div class="modal-body text-center py-4">
          <!-- Download SVG icon from http://tabler-icons.io/i/circle-check -->
          <svg xmlns="http://www.w3.org/2000/svg" class="icon mb-2 text-danger icon-lg" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M12 9v2m0 4v.01" /><path d="M5 19h14a2 2 0 0 0 1.84 -2.75l-7.1 -12.25a2 2 0 0 0 -3.5 0l-7.1 12.25a2 2 0 0 0 1.75 2.75" /></svg>
          <h3><%= message.errorDelete %></h3>
        </div>
        <div class="modal-footer">
          <div class="w-100">
            <div class="row">
              <div class="col">
                <a href="#" class="btn btn-danger w-100" data-bs-dismiss="modal">
                  Close
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Tabler Core -->
  <script src="/assets/tabler/js/tabler.min.js"></script>
  <script src="/assets/tabler/js/demo.min.js"></script>

  <!--<script src="https://cdnjs.cloudflare.com/ajax/libs/litepicker/2.0.11/litepicker.js" defer></script>-->
  <script src="/assets/tabler/libs/litepicker/dist/litepicker.js" ></script>

  <% var messageErrorDelete = message.errorDelete; %>
  <script type = "text/JavaScript">
    var editModal = document.getElementById('modal-edit');
    editModal.addEventListener('show.bs.modal', function (event) {
      // Button that triggered the modal
      var button = event.relatedTarget
      // Extract info from data-bs-* attributes
      var Id = button.getAttribute('data-id')
      var description = button.getAttribute('data-description')
      var percentage = button.getAttribute('data-percentage')
      // If necessary, you could initiate an AJAX request here
      // and then do the updating in a callback.
      //
      // Update the modal's content.
      var modalTitle = editModal.querySelector('.modal-title')

      var modalId = editModal.querySelector(".id");
      var modalDescription = editModal.querySelector(".description");
      var modalPercentage = editModal.querySelector(".percentage");
      var isActive = button.getAttribute('data-is_active');

      modalId.value = Id;
      modalDescription.value = description;
      modalPercentage.value = percentage;

      var modalIsActive = editModal.querySelector(".is-active");
      var modalChkIsActive = editModal.querySelector(".chk-is-active");
      if (isActive == 1) {
        modalChkIsActive.removeAttribute('checked');
        modalChkIsActive.toggleAttribute('checked');
      } else {
        modalChkIsActive.removeAttribute('checked');
      }
    })

    /*
    var deleteModal = document.getElementById('modal-danger');
    deleteModal.addEventListener('show.bs.modal', function (event) {
      // Button that triggered the modal
      var button = event.relatedTarget
      // Extract info from data-bs-* attributes
      var Id = button.getAttribute('data-id')

      var modalId= deleteModal.querySelector(".id");
      modalId.value = Id;
    })

    let getMessageErrorDelete = "<%= messageErrorDelete %>";
    if(getMessageErrorDelete) {
      var errorDelereModal = new bootstrap.Modal(document.getElementById('modal-error'), {})
      errorDelereModal.toggle();
    } */

    let chkIsActive = document.querySelectorAll('.chk-is-active')
    chkIsActive.forEach((checkbox) => { 
      checkbox.addEventListener('change', (event) => {
        let txtChkEdit = editModal.querySelector(".is-active");
        if (event.target.checked) {
          txtChkEdit.value = 1;
          event.target.value = 1;
        } else {
          txtChkEdit.value = 0;
          event.target.value = 0;
        }
      })
    })
  </script>
</body>
</html>
