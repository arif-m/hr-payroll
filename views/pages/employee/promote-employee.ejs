<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('./../layouts/head'); %>
</head>
<body>  
  <div class="page">
    <aside class="navbar navbar-vertical navbar-expand-lg navbar-dark">
      <%- include('./../layouts/side'); %>
    </aside>
    <%- include('./../layouts/header1'); %>
  
    <div class="page-wrapper">
      <div class="container-xl">
        <%- include('./../layouts/header2'); %>
      </div>
      <div class="page-body">
        <div class="container-xl">
          <div class="row row-deck row-cards">
            <div class="col-12">
              <div class="card">
                  <div class="card-header">
                    <h3 class="card-title">Data Listing</h3>
                  </div>
                  <div class="card-body border-bottom py-3">
                    <form action="/promote-employee" id="frmSearch" type="GET">
                      <div class="d-flex">
                        <div class="text-muted">
                        Show
                        <div class="mx-2 d-inline-block">
                            <input type="text" class="form-control form-control-sm" value="<%= listOfPromoteEmployee.meta.limit %>" size="3" aria-label="data count">
                        </div>
                        entries
                        </div>
                        <div class="ms-auto text-muted">
                          <div class="input-group mb-2">
                            <input type="text" id="search" name="search" class="form-control form-control-sm" placeholder="search data" value="<% if(locals.search) { %><%= search  %><% } %>">
                            <button class="btn" type="submit">Go</button>
                          </div>
                        </div>
                    </form>
                  </div>

                  <div class="table-responsive">
                    <table class="table card-table table-vcenter text-nowrap datatable" id="mytable">
                      <thead>
                      <tr>
                        <th>Action</th>
                        <th>Emp Id</th>
                        <th>Name</th>
                        <th>Status</th>
                        <th>Role</th>
                        <th>Empl Status</th>
                        <th>Job Title</th>
                        <th>Division</th>
                        <th>Join Date</th>
                      </tr>
                      </thead>
                      <tbody>
                        <% listOfPromoteEmployee.data.forEach(function(employee) { %>
                          <tr>
                            <td class="text-left">
                              <button class="btn btn-outline-primary ms-auto edit" data-bs-toggle="modal" data-bs-target="#modal-edit" data-id="<%= employee.id %>" data-uuid="<%= employee.uuid %>" data-full_name="<%= employee.fullName %>" >Promote</button>
                            </td>
                            <td><%= employee.employeeId %></td>
                            <td><%= employee.fullName %></td>
                            <td><%= employee.status %></td>
                            <td><%= employee.role.roleName %></td>
                            <td><%= employee.employmentStatus %></td>
                            <td><%= employee.jobTitle.jobTitleName %></td>
                            <td><%= employee.division.divisionName %></td>
                            <td><%= moment(employee.joinDate).format('DD-MM-YYYY') %></td>
                          </tr>
                          <% }); %>                       
                      </tbody>
                    </table>
                  </div>
                                    
                  <div class="card-footer d-flex align-items-center">
                    <p class="m-0 text-muted">Showing <span>1</span> to <span><%= listOfPromoteEmployee.meta.totalRecordCurrentPage %></span> of <span><%= listOfPromoteEmployee.meta.totalRecords %></span> entries</p>
                    <% if (listOfPromoteEmployee.meta.totalPage > 1) { %>
                    <ul class="pagination m-0 ms-auto">
                      <% if (listOfPromoteEmployee.meta.currentPage == 0) { %>
                        <li class="page-item  disabled"><a class="btn btn-outline-primary ms-auto disabled btn-sm"><< First</a></li>&nbsp;
                      <% } else { %>
                          <li class="page-item"><a class="btn btn-outline-primary ms-auto inactive btn-sm" href="/promote-employee?page=0&limit=<%= listOfPromoteEmployee.meta.limit %>"><< First</a></li>&nbsp;
                      <% } %>
                      
                      <% if (listOfPromoteEmployee.meta.currentPage == 0) { %>
                        <li class="page-item  disabled"><a class="btn btn-outline-primary ms-auto disabled btn-sm">< Prev</a></li>&nbsp;
                      <% } else { %>
                          <li class="page-item"><a class="btn btn-outline-primary ms-auto inactive btn-sm" href="/promote-employee?page=<%= listOfPromoteEmployee.meta.currentPage-1 %>&limit=<%= listOfPromoteEmployee.meta.limit %>">< Previous</a></li>&nbsp;
                      <% } %>

                      <% if ((listOfPromoteEmployee.meta.currentPage + 1) == listOfPromoteEmployee.meta.totalPage) { %>
                        <li class="page-item  disabled"><a class="btn btn-outline-primary ms-auto disabled btn-sm">Next ></Next></a></li>&nbsp;
                      <% } else { %>
                          <li class="page-item"><a class="btn btn-outline-primary ms-auto inactive btn-sm" href="/promote-employee?page=<%= listOfPromoteEmployee.meta.currentPage+1 %>&limit=<%= listOfPromoteEmployee.meta.limit %>"> Next ></a></li>&nbsp;
                      <% } %>

                      <% if (listOfPromoteEmployee.meta.currentPage == (listOfPromoteEmployee.meta.totalPage-1)) { %>
                        <li class="disabled"><a class="btn btn-outline-primary ms-auto disabled btn-sm">Last >></a></li>&nbsp;
                      <% } else { %>
                          <li><a class="btn btn-outline-primary ms-auto inactive btn-sm" href="/promote-employee?page=<%= listOfPromoteEmployee.meta.totalPage - 1 %>&limit=<%= listOfPromoteEmployee.meta.limit %>">Last >></a></li>
                      <% } %>
                    </ul>
                    <% } %>
                  </div> 
              </div>
            </div>
          </div>
        </div>
      </div>
      <footer class="footer footer-transparent d-print-none">
        <%- include('./../layouts/footer'); %>
      </footer>
    </div>
  </div>
  
  <div class="modal modal-blur fade" id="modal-edit" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Promote Employee</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <form id="frmEdit" class="card card-md" method="POST" action="/employee/promote-employee"  autocomplete="off">
          <div class="modal-body">
            <div class="row">
                <div class="col-lg-6">
                    <div class="mb-3">
                        <label class="form-label">Full Name</label>
                        <input type="hidden" name="id" id="id" class="id" >
                        <input type="hidden" name="employee_uuid" id="employee_uuid" class="employee-uuid" >
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <input type="text" class="form-control full-name" name="full_name" id="full_name" placeholder="Name of Employee" disabled>
                    </div>   
                </div>     
                <div class="col-lg-6">
                  <div class="mb-3">
                      <label class="form-label">Join Date</label>
                      <input type="text" class="form-control join-date" placeholder="YYYY-MM-DD" name="join_date_edit" id="join_date_edit" disabled>
                  </div>
                </div>            
                <div class="col-lg-6">
                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input type="text" class="form-control email" name="email" id="email" placeholder="Email" disabled>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="mb-3">
                        <label class="form-label">Role</label>
                        <select name="role" id="role" class="form-control role" disabled>
                            <% listOfRoles.forEach(function(role) { %>
                            <option value="<%= role.id %>">
                              <%= role.roleName %></option>
                            <% }); %>
                        </select>
                    </div>
                </div>   
                <div class="col-lg-6">
                  <div class="mb-3">
                      <label class="form-label">Job Title</label>
                      <select name="jobtitle" id="jobtitle" class="form-control jobtitle" disabled>
                          <% listOfJobTitles.forEach(function(jobtitle) { %>
                          <option value="<%= jobtitle.id %>">
                            <%= jobtitle.jobTitleName %>
                          </option>
                          <% }); %>
                      </select>
                  </div>
              </div>   
              <div class="col-lg-6">
                <div class="mb-3">
                    <label class="form-label">Division</label>
                    <select name="division" id="division" class="form-control division" disabled>
                        <% listOfDivision.forEach(function(division) { %>
                        <option value="<%= division.id %>">
                          <%= division.divisionName %>
                        </option>
                        <% }); %>
                    </select>
                </div>
              </div>   
              <div class="col-lg-6">
                <div class="mb-3">
                    <label class="form-label">Promote Date</label>
                    <input type="text" class="form-control promote-date" name="promote_date" id="promote_date" placeholder="DD-MM-YYYY" required>
                </div>
              </div>               
            </div>
          </div>
        
          <div class="modal-footer">
            <button type="button" class="btn me-auto" data-bs-dismiss="modal">Close</button>
            <button id="updateBtn" class="btn btn-primary ms-auto" type="submit">
              Promote
            </button>
          </div>
        </form>
    </div>
    </div>
  </div>

  <div class="modal modal-blur fade" id="modal-success" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-sm modal-dialog-centered" role="document">
      <div class="modal-content">
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        <div class="modal-status bg-success"></div>
        <div class="modal-body text-center py-4">
          <!-- Download SVG icon from http://tabler-icons.io/i/circle-check -->
          <svg xmlns="http://www.w3.org/2000/svg" class="icon mb-2 text-green icon-lg" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><circle cx="12" cy="12" r="9" /><path d="M9 12l2 2l4 -4" /></svg>
          <h3><%= message.success %></h3>
        </div>
        <div class="modal-footer">
          <div class="w-100">
            <div class="row">
              <div class="col">
                <a href="#" class="btn btn-success w-100" data-bs-dismiss="modal">
                  OK
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Tabler Core -->
  <script src="/assets/tabler/js/tabler.min.js"></script>
  <script src="/assets/tabler/js/demo.min.js"></script>

  <% var messageSuccess = message.success; %>
  <script src="/assets/tabler/libs/litepicker/dist/litepicker.js" ></script>
  <script type = "text/JavaScript">
    document.addEventListener("DOMContentLoaded", function () {
    	window.Litepicker && (new Litepicker({
    		element: document.getElementById('promote_date'),
        format: 'DD-MM-YYYY',
    		buttonText: {
    			previousMonth: `<!-- Download SVG icon from http://tabler-icons.io/i/chevron-left -->
    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><polyline points="15 6 9 12 15 18" /></svg>`,
    			nextMonth: `<!-- Download SVG icon from http://tabler-icons.io/i/chevron-right -->
    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><polyline points="9 6 15 12 9 18" /></svg>`,
    		},
    	}));

    });

    var editModal = document.getElementById('modal-edit');
    editModal.addEventListener('show.bs.modal', function (event) {
      // Button that triggered the modal
      var button = event.relatedTarget
      // Extract info from data-bs-* attributes
      var employeeId = button.getAttribute('data-id')
      var employeeUuid = button.getAttribute('data-uuid')
      var employeeName = button.getAttribute('data-full_name')
      // If necessary, you could initiate an AJAX request here
      // and then do the updating in a callback.
      //
      let url = '/employee/' + employeeUuid;
      fetch(url)
        .then(res => res.json())
        .then(json => {
          //console.log(json);                
          let modalStatus= editModal.querySelector(".status");
          let modalRole = editModal.querySelector(".role");
          let modalEmployeeUuid = editModal.querySelector(".employee-uuid");
          let modalId = editModal.querySelector(".id");
          let modalEmployeeName = editModal.querySelector(".full-name");
          let modalJoinDate = editModal.querySelector(".join-date");
          let modalEmail = editModal.querySelector(".email");

          // Deserialize json because have BIG INT data type
          const jsonDeserialize = JSON.parse(json.data, (key, value) => {
              if (typeof value === "string" && value.startsWith('BIGINT::')) {
                  return BigInt(value.substr(8));
              }
              return value;
          });

          modalRole.value = jsonDeserialize.role.id;
          modalEmployeeUuid.value = jsonDeserialize.uuid;
          modalId.value = jsonDeserialize.id;
          modalEmployeeName.value = jsonDeserialize.fullName;

          let joinDate =  new Date(jsonDeserialize.joinDate);
          var dd = String(joinDate.getDate()).padStart(2, '0');
          var mm = String(joinDate.getMonth() + 1).padStart(2, '0'); //January is 0!
          var yyyy = joinDate.getFullYear();

          joinDate = dd + '-' + mm + '-' + yyyy ;
          modalJoinDate.value = joinDate;
          modalEmail.value = jsonDeserialize.email;

          const selectJobTitle = document.getElementById('jobtitle');
          selectJobTitle.value = jsonDeserialize.jobTitle.id;

          const selectDivision = document.getElementById('division');
          selectDivision.value = jsonDeserialize.division.id;
        })
    })

    //on change role field
    /*
    const selectEmploymentStatus = document.getElementById('employment_status');
    selectEmploymentStatus.addEventListener('change', function handleChange(event) {

      let modalEmployementStatusName = editModal.querySelector(".employment-status-name");
      modalEmployementStatusName.value = selectEmploymentStatus.options[selectEmploymentStatus.selectedIndex].text;

    }); */

    let getMessageSuccess = "<%= messageSuccess %>";
    if(getMessageSuccess) {
      var successModal = new bootstrap.Modal(document.getElementById('modal-success'), {})
      successModal.toggle();
    }
  </script>
</body>
</html>
