<html lang="en">
  <head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
    <meta http-equiv="X-UA-Compatible" content="ie=edge"/>
    <title>Reset password - HR PAYROLL</title>
    <!-- CSS files -->
    <link href="/assets/tabler/css/tabler.min.css" rel="stylesheet"/>
    <link href="/assets/tabler/css/demo.min.css" rel="stylesheet"/>
  </head>
  <body  class=" border-top-wide border-primary d-flex flex-column">
    <div class="page page-center">
      <div class="container-tight py-4">
        <div class="text-center mb-4">
          <a href="." class="navbar-brand navbar-brand-autodark"><img src="./static/logo.svg" height="36" alt=""></a>
        </div>
        <form class="card card-md" action="/reset-password" method="POST">
          <div class="card-body">
            <h2 class="card-title text-center mb-4">Reset password</h2>
            <p class="text-muted mb-4">Enter your new password to reset your password.</p>
            <!--<div class="mb-3 ">
              <label class="form-label">Password</label>
              <input type="password" name="password" id="password" class="form-control" placeholder="Enter password">
              <input type="hidden" name="token" id="token" class="form-control" value="<%= token %>">
              <input type="hidden" name="uuid" id="uuid" class="form-control" value="<%= uuid %>">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <span class="input-group-text">
                <a href="#" class="link-secondary" title="Show password" data-bs-toggle="tooltip">
                  <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><circle cx="12" cy="12" r="2" /><path d="M22 12c-2.667 4.667 -6 7 -10 7s-7.333 -2.333 -10 -7c2.667 -4.667 6 -7 10 -7s7.333 2.333 10 7" /></svg>
                </a>
              </span>
            </div>-->
            <div class="mb-2">
              <label class="form-label">
                Password
              </label>
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <div class="input-group input-group-flat">
                <input type="password" class="form-control" name="password" id="password" placeholder="Password" autocomplete="off">
                <input type="hidden" name="token" id="token" class="form-control" value="<%= token %>">
                <input type="hidden" name="uuid" id="uuid" class="form-control" value="<%= uuid %>">
                <span class="input-group-text">
                  <a href="#" class="link-secondary" title="Show password" data-bs-toggle="tooltip" id="togglePassword"><!-- Download SVG icon from http://tabler-icons.io/i/eye -->
                    <svg id="eye-off" xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-eye-off" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                      <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                      <line x1="3" y1="3" x2="21" y2="21"></line>
                      <path d="M10.584 10.587a2 2 0 0 0 2.828 2.83"></path>
                      <path d="M9.363 5.365a9.466 9.466 0 0 1 2.637 -.365c4 0 7.333 2.333 10 7c-.778 1.361 -1.612 2.524 -2.503 3.488m-2.14 1.861c-1.631 1.1 -3.415 1.651 -5.357 1.651c-4 0 -7.333 -2.333 -10 -7c1.369 -2.395 2.913 -4.175 4.632 -5.341"></path>
                    </svg>
                    <svg id="eye" style="display: none" xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><circle cx="12" cy="12" r="2" /><path d="M22 12c-2.667 4.667 -6 7 -10 7s-7.333 -2.333 -10 -7c2.667 -4.667 6 -7 10 -7s7.333 2.333 10 7" /></svg>
                  </a>
                </span>
              </div>
            </div>
            <div class="mb-3">
              <label class="form-label">Password Confirmation</label>
              <div class="input-group input-group-flat">
                <input type="password" name="password_confirmation" id="password_confirmation" class="form-control" placeholder="Enter password confirmation">
                <span class="input-group-text">
                  <a href="#" class="link-secondary" title="Show password confirmation" data-bs-toggle="tooltip" id="togglePassword2"><!-- Download SVG icon from http://tabler-icons.io/i/eye -->
                    <svg id="eye-off2" xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-eye-off" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                      <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                      <line x1="3" y1="3" x2="21" y2="21"></line>
                      <path d="M10.584 10.587a2 2 0 0 0 2.828 2.83"></path>
                      <path d="M9.363 5.365a9.466 9.466 0 0 1 2.637 -.365c4 0 7.333 2.333 10 7c-.778 1.361 -1.612 2.524 -2.503 3.488m-2.14 1.861c-1.631 1.1 -3.415 1.651 -5.357 1.651c-4 0 -7.333 -2.333 -10 -7c1.369 -2.395 2.913 -4.175 4.632 -5.341"></path>
                    </svg>
                    <svg id="eye2" style="display: none;" xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><circle cx="12" cy="12" r="2" /><path d="M22 12c-2.667 4.667 -6 7 -10 7s-7.333 -2.333 -10 -7c2.667 -4.667 6 -7 10 -7s7.333 2.333 10 7" /></svg>
                  </a>
                </span>
              </div>
            </div>
            <div class="form-footer">
              <button class="btn btn-primary ms-auto w-100" type="submit">
                Submit
              </button>
            </div>
          </div>
        </form>
      </div>
    </div>

    <div class="modal modal-blur fade" id="modal-success" tabindex="-1" role="dialog" aria-hidden="true">
      <div class="modal-dialog modal-sm modal-dialog-centered" role="document">
        <div class="modal-content">
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          <div class="modal-status bg-success"></div>
          <div class="modal-body text-center py-4">
            <!-- Download SVG icon from http://tabler-icons.io/i/circle-check -->
            <svg xmlns="http://www.w3.org/2000/svg" class="icon mb-2 text-green icon-lg" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><circle cx="12" cy="12" r="9" /><path d="M9 12l2 2l4 -4" /></svg>
            <h3><%= message.success %></h3>
          </div>
          <div class="modal-footer">
            <div class="w-100">
              <div class="row">
                <div class="col">
                  <a href="#" class="btn btn-success w-100" data-bs-dismiss="modal">
                    OK
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="modal modal-blur fade" id="modal-error" tabindex="-1" role="dialog" aria-hidden="true">
      <div class="modal-dialog modal-sm modal-dialog-centered" role="document">
        <div class="modal-content">
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          <div class="modal-status bg-danger"></div>
          <div class="modal-body text-center py-4">
            <!-- Download SVG icon from http://tabler-icons.io/i/circle-check -->
            <svg xmlns="http://www.w3.org/2000/svg" class="icon mb-2 text-danger icon-lg" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M12 9v2m0 4v.01" /><path d="M5 19h14a2 2 0 0 0 1.84 -2.75l-7.1 -12.25a2 2 0 0 0 -3.5 0l-7.1 12.25a2 2 0 0 0 1.75 2.75" /></svg>
            <h3><%= message.error %></h3>
          </div>
          <div class="modal-footer">
            <div class="w-100">
              <div class="row">
                <div class="col">
                  <a href="#" class="btn btn-danger w-100" data-bs-dismiss="modal">
                    Close
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Tabler Core -->
    <script src="/assets/tabler/js/tabler.min.js"></script>
    <script src="/assets/tabler/js/demo.min.js"></script>

    <% var messageSuccess = message.success; %>
    <% var messageError = message.error; %>
    <script>
      let getMessageSuccess = "<%= messageSuccess %>";
      if(getMessageSuccess) {
        var successModal = new bootstrap.Modal(document.getElementById('modal-success'), {})
        successModal.toggle();
      }

      let getMessageError = "<%= messageError %>";
      if(getMessageError) {
        var errorModal = new bootstrap.Modal(document.getElementById('modal-error'), {})
        errorModal.toggle();
      }

      const togglePassword = document.querySelector('#togglePassword');
      const password = document.querySelector('#password');

      togglePassword.addEventListener('click', function (e) {
        // toggle the type attribute
        const type = password.getAttribute('type') === 'password' ? 'text' : 'password';
        password.setAttribute('type', type);

        if ( password.getAttribute('type') === 'password' ) {
          document.getElementById("eye-off").style.display = "block";
          document.getElementById("eye").style.display = "none";
          togglePassword.setAttribute('title', 'Show Password');
          togglePassword.setAttribute('data-bs-original-title', 'Show Password')
        } else {
          document.getElementById("eye").style.display = "block";
          document.getElementById("eye-off").style.display = "none";
          togglePassword.setAttribute('title', 'Hide Password');
          togglePassword.setAttribute('data-bs-original-title', 'Hide Password')
        }
      });

      const togglePassword2 = document.querySelector('#togglePassword2');
      const passwordConfirmation = document.querySelector('#password_confirmation');

      togglePassword2.addEventListener('click', function (e) {
        // toggle the type attribute
        const type = passwordConfirmation.getAttribute('type') === 'password' ? 'text' : 'password';
        passwordConfirmation.setAttribute('type', type);

        if ( passwordConfirmation.getAttribute('type') === 'password' ) {
          document.getElementById("eye-off2").style.display = "block";
          document.getElementById("eye2").style.display = "none";
          togglePassword2.setAttribute('title', 'Show Password Confirmation');
          togglePassword2.setAttribute('data-bs-original-title', 'Show Password Confirmation')
        } else {
          document.getElementById("eye2").style.display = "block";
          document.getElementById("eye-off2").style.display = "none";
          togglePassword2.setAttribute('title', 'Hide Password Confirmation');
          togglePassword2.setAttribute('data-bs-original-title', 'Hide Password Confirmation')
        }

      });

    </script>
  </body>
</html>