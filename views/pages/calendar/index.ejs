<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('./../layouts/head'); %>
</head>
<body>  
  <div class="page">
    <aside class="navbar navbar-vertical navbar-expand-lg navbar-dark">
      <%- include('./../layouts/side'); %>
    </aside>
    <%- include('./../layouts/header1'); %>
  
    <div class="page-wrapper">
      <div class="container-xl">
        <%- include('./../layouts/header2'); %>
      </div>
      <div class="page-body">
        <div class="container-xl">
          <div class="row row-deck row-cards">
            <div class="col-12">
              <div class="card">
                  <div class="card-header">
                    <h3 class="card-title">Data Listing</h3>
                  </div>
                  <div class="card-body border-bottom py-3">
                    <div class="col-12 mb-3">
                      <button class="btn btn-outline-primary ms-auto" data-bs-toggle="modal" data-bs-target="#modal-add">Add</button><br />
                    </div>
                    <form action="/calendar" id="frmSearch" type="GET">
                      <div class="d-flex">
                        <div class="text-muted">
                        Show
                        <div class="mx-2 d-inline-block">
                            <input type="text" class="form-control form-control-sm" value="<%= listOfCalendar.meta.limit %>" size="3" aria-label="data count">
                        </div>
                        entries
                        </div>
                        <div class="ms-auto text-muted">
                          <div class="input-group mb-2">
                            <input type="text" id="search" name="search" class="form-control form-control-sm" placeholder="search data" value="<% if(locals.search) { %><%= search  %><% } %>">
                            <button class="btn" type="submit">Go</button>
                          </div>
                        </div>
                    </form>
                  </div>

                  <div class="table-responsive">
                    <table class="table card-table table-vcenter text-nowrap datatable" id="mytable">
                      <thead>
                      <tr>
                        <th class="w-1">Id. <!-- Download SVG icon from http://tabler-icons.io/i/chevron-up -->
                          <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-sm text-dark icon-thick" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><polyline points="6 15 12 9 18 15" /></svg>
                        </th>
                        <th>Event Date</th>
                        <th>Event Name</th>
                        <th>Is Workdays ?</th>
                        <th></th>
                      </tr>
                      </thead>
                      <tbody>
                        <% listOfCalendar.data.forEach(function(data) { %>
                          <tr>
                              <td><span class="text-muted"><%= data.id %></span></td>
                              <td><%=  moment(data.eventDate).format('DD-MM-yyyy') %></td>
                              <td><%= data.eventName %></td>
                              <td>
                                <% if(data.is_workdays == 0) { %>
                                No
                                <% } else { %>
                                Yes
                                <% } %>
                                </td>
                              <td class="text-end">
                                <button class="btn btn-outline-primary ms-auto edit" data-bs-toggle="modal" data-bs-target="#modal-edit" data-id="<%= data.id %>" data-uuid="<%= data.uuid %>"  data-event_date="<%= data.eventDate %>" data-event_name="<%= data.eventName %>" data-is_workdays="<%= data.is_workdays %>" data-description="<%= data.description %>">Edit</button>
                                <button class="btn btn-outline-danger ms-auto delete" data-bs-toggle="modal" data-bs-target="#modal-danger" data-id="<%= data.id %>" data-uuid="<%= data.uuid %>">Delete</button>
                              </td>
                          </tr>
                          <% }); %>                     
                      </tbody>
                    </table>
                  </div>
                                    
                  <div class="card-footer d-flex align-items-center">
                    <p class="m-0 text-muted">Showing <span>1</span> to <span><%= listOfCalendar.meta.limit %></span> of <span><%= listOfCalendar.meta.totalRecords %></span> entries</p>
                    <% if (listOfCalendar.meta.totalPage > 1) { %>
                    <ul class="pagination m-0 ms-auto">
                      <% if (listOfCalendar.meta.currentPage == 0) { %>
                        <li class="page-item  disabled"><a class="btn btn-outline-primary ms-auto disabled btn-sm"><< First</a></li>&nbsp;
                      <% } else { %>
                          <li class="page-item"><a class="btn btn-outline-primary ms-auto inactive btn-sm" href="/calendar?page=0&limit=<%= listOfCalendar.meta.limit %>"><< First</a></li>&nbsp;
                      <% } %>
                      
                      <% if (listOfCalendar.meta.currentPage == 0) { %>
                        <li class="page-item  disabled"><a class="btn btn-outline-primary ms-auto disabled btn-sm">< Prev</a></li>&nbsp;
                      <% } else { %>
                          <li class="page-item"><a class="btn btn-outline-primary ms-auto inactive btn-sm" href="/calendar?page=<%= listOfCalendar.meta.currentPage-1 %>&limit=<%= listOfCalendar.meta.limit %>">< Previous</a></li>&nbsp;
                      <% } %>
  
                      <% if ((listOfCalendar.meta.currentPage + 1) == listOfCalendar.meta.totalPage) { %>
                        <li class="page-item  disabled"><a class="btn btn-outline-primary ms-auto disabled btn-sm">Next ></Next></a></li>&nbsp;
                      <% } else { %>
                          <li class="page-item"><a class="btn btn-outline-primary ms-auto inactive btn-sm" href="/calendar?page=<%= listOfCalendar.meta.currentPage+1 %>&limit=<%= listOfCalendar.meta.limit %>"> Next ></a></li>&nbsp;
                      <% } %>
  
                      <% if (listOfCalendar.meta.currentPage == (listOfCalendar.meta.totalPage-1)) { %>
                        <li class="disabled"><a class="btn btn-outline-primary ms-auto disabled btn-sm">Last >></a></li>&nbsp;
                      <% } else { %>
                          <li><a class="btn btn-outline-primary ms-auto inactive btn-sm" href="/calendar?page=<%= listOfCalendar.meta.totalPage - 1 %>&limit=<%= listOfCalendar.meta.limit %>">Last >></a></li>
                      <% } %>
                    </ul>
                    <% } %>
                  </div> 
              </div>
            </div>
          </div>
        </div>
      </div>
      
      <footer class="footer footer-transparent d-print-none">
        <%- include('./../layouts/footer'); %>
      </footer>
    </div>
  </div>
  
  <div class="modal modal-blur fade" id="modal-add" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">New Calendar</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <form class="card card-md" method="POST" action="/calendar" autocomplete="off">
          <div class="modal-body">
            <div class="mb-3">
              <label class="form-label">Event Date</label>
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="text" class="form-control" name="event_date" id="event_date" placeholder="Date of event" required>
            </div>          
            <div class="mb-3">
              <label class="form-label">Event Name</label>
              <input type="text" class="form-control" name="event_name" id="event_name" placeholder="Name of event" required>
            </div>          
            <div class="mb-3">
              <label class="form-label">Description Name</label>
              <textarea class="form-control" name="description" id="description" rows="4" placeholder="Description"></textarea>
            </div>          
            <div class="mb-3">
              <label class="form-label">Is Workdays ?</label>
              <input type="hidden" class="form-control is_workdays" name="is_workdays" id="is_workdays">
              <input type="checkbox" class="chk_is_workdays" id="chk_is_workdays" name="chk_is_workdays" >
            </div>          
          </div>
        
          <div class="modal-footer">
            <button type="button" class="btn me-auto" data-bs-dismiss="modal">Close</button>
            <button class="btn btn-primary ms-auto" type="submit">
              Insert Data
            </button>
          </div>
        </form>
    </div>
    </div>
  </div>

  <div class="modal modal-blur fade" id="modal-edit" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Edit Calendar</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <form id="frmEdit" class="card card-md" method="POST" action="/calendar/update"  autocomplete="off">
          <div class="modal-body">
            <div class="mb-3">
              <label class="form-label">Event Date</label>
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="event_id" id="event_id" class="event-id">
              <input type="hidden" name="event_uuid" id="event_uuid" class="event-uuid">
              <input type="text" class="form-control event-date" name="event_date" id="event_date_edit" placeholder="Date of event" required>
            </div>          
            <div class="mb-3">
              <label class="form-label">Name</label>
              <input type="text" class="form-control event-name" name="event_name" id="event_name" placeholder="Name of event" required>
              <input type="hidden" class="event-name2" name="event_name2" id="event_name2">
            </div>
            <div class="mb-3">
              <label class="form-label">Description Name</label>
              <textarea class="form-control description" name="description" id="description" rows="4" placeholder="Description"></textarea>
            </div>          
            <div class="mb-3">
              <label class="form-label">Is Workdays</label>
              <input type="hidden" class="form-control is_workdays" name="is_workdays" id="is_workdays" >
              <input type="checkbox" class="chk_is_workdays" id="chk_is_workdays" name="chk_is_workdays" >
            </div>                    
          </div>
        
          <div class="modal-footer">
            <button type="button" class="btn me-auto" data-bs-dismiss="modal">Close</button>
            <button id="updateBtn" class="btn btn-primary ms-auto" type="submit">
              Update Data
            </button>
          </div>
        </form>
    </div>
    </div>
  </div>

  <div class="modal modal-blur fade" id="modal-danger" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-sm modal-dialog-centered" role="document">
      <div class="modal-content">
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        <div class="modal-status bg-danger"></div>
        <form class="card card-md" method="POST" action="/calendar/delete" autocomplete="off">
          <div class="modal-body text-center py-4">
            <!-- Download SVG icon from http://tabler-icons.io/i/alert-triangle -->
            <svg xmlns="http://www.w3.org/2000/svg" class="icon mb-2 text-danger icon-lg" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M12 9v2m0 4v.01" /><path d="M5 19h14a2 2 0 0 0 1.84 -2.75l-7.1 -12.25a2 2 0 0 0 -3.5 0l-7.1 12.25a2 2 0 0 0 1.75 2.75" /></svg>
            <h3>Are you sure?</h3>
            <div class="text-muted">Do you really want to remove the data? What you've done cannot be undone.</div>
            <input type="hidden" name="event_id" id="event_id" class="event-id">
            <input type="hidden" name="event_uuid" id="event_uuid" class="event-uuid">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          </div>
          <div class="modal-footer">
            <div class="w-100">
              <div class="row">
                <div class="col"><a href="#" class="btn w-100" data-bs-dismiss="modal">
                    Cancel
                  </a>
                </div>
                <button id="deleteBtn" class="col btn btn-danger ms-auto" type="submit" data-bs-dismiss="modal">
                  Delete Data
                </button>
              </div>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
  
  <div class="modal modal-blur fade" id="modal-error" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-sm modal-dialog-centered" role="document">
      <div class="modal-content">
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        <div class="modal-status bg-danger"></div>
        <div class="modal-body text-center py-4">
          <!-- Download SVG icon from http://tabler-icons.io/i/circle-check -->
          <svg xmlns="http://www.w3.org/2000/svg" class="icon mb-2 text-danger icon-lg" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M12 9v2m0 4v.01" /><path d="M5 19h14a2 2 0 0 0 1.84 -2.75l-7.1 -12.25a2 2 0 0 0 -3.5 0l-7.1 12.25a2 2 0 0 0 1.75 2.75" /></svg>
          <h3><%= message.errorDelete %></h3>
        </div>
        <div class="modal-footer">
          <div class="w-100">
            <div class="row">
              <div class="col">
                <a href="#" class="btn btn-danger w-100" data-bs-dismiss="modal">
                  Close
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Tabler Core -->
  <script src="/assets/tabler/js/tabler.min.js"></script>
  <script src="/assets/tabler/js/demo.min.js"></script>
  <script src="/assets/tabler/libs/litepicker/dist/litepicker.js" ></script>

  <% var messageErrorDelete = message.errorDelete; %>
  <script type = "text/JavaScript">
    document.addEventListener("DOMContentLoaded", function () {
    	window.Litepicker && (new Litepicker({
    		element: document.getElementById('event_date'),
        format: 'DD-MM-YYYY',
        dropdowns: {
          minYear: new Date().getFullYear() - 150,
          maxYear: new Date().getFullYear() + 100,
          months: true,
          //years: true
        },
    		buttonText: {
    			previousMonth: `<!-- Download SVG icon from http://tabler-icons.io/i/chevron-left -->
    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><polyline points="15 6 9 12 15 18" /></svg>`,
    			nextMonth: `<!-- Download SVG icon from http://tabler-icons.io/i/chevron-right -->
    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><polyline points="9 6 15 12 9 18" /></svg>`,
    		},
    	}));

      window.Litepicker && (new Litepicker({
    		element: document.getElementById('event_date_edit'),
        format: 'DD-MM-YYYY',
    		buttonText: {
    			previousMonth: `<!-- Download SVG icon from http://tabler-icons.io/i/chevron-left -->
    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><polyline points="15 6 9 12 15 18" /></svg>`,
    			nextMonth: `<!-- Download SVG icon from http://tabler-icons.io/i/chevron-right -->
    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><polyline points="9 6 15 12 9 18" /></svg>`,
    		},
    	}));

    });

    var addModal = document.getElementById('modal-add');

    var editModal = document.getElementById('modal-edit');
    editModal.addEventListener('show.bs.modal', function (event) {
      // Button that triggered the modal
      var button = event.relatedTarget
      // Extract info from data-bs-* attributes
      var eventId = button.getAttribute('data-id');
      var eventUuid = button.getAttribute('data-uuid');
      var eventDate = button.getAttribute('data-event_date');
      var eventName = button.getAttribute('data-event_name');
      var description = button.getAttribute('data-description');
      var isWorkdays = button.getAttribute('data-is_workdays');

      // If necessary, you could initiate an AJAX request here
      // and then do the updating in a callback.
      //
      // Update the modal's content.
      var modalTitle = editModal.querySelector('.modal-title');

      var modalEventId = editModal.querySelector(".event-id");
      var modalEventUuid = editModal.querySelector(".event-uuid");
      var modalEventDate = editModal.querySelector(".event-date");
      var modalEventName = editModal.querySelector(".event-name");
      var modalEventName2 = editModal.querySelector(".event-name2");
      var modalDescription = editModal.querySelector(".description");
      var modalIsWorkdays = editModal.querySelector(".is_workdays");
      var modalChkIsWorkdays = editModal.querySelector(".chk_is_workdays");
      if (isWorkdays == 1) {
        modalChkIsWorkdays.removeAttribute('checked');
        modalChkIsWorkdays.toggleAttribute('checked');
      } else {
        modalChkIsWorkdays.removeAttribute('checked');
      }

      modalEventId.value = eventId;
      modalEventUuid.value = eventUuid;

      let eventDt =  new Date(eventDate);
      var dd = String(eventDt.getDate()).padStart(2, '0');
      var mm = String(eventDt.getMonth() + 1).padStart(2, '0'); //January is 0!
      var yyyy = eventDt.getFullYear();
      eventDt = dd + '-' + mm + '-' + yyyy;

      modalEventDate.value = eventDt;
      modalEventName.value = eventName;
      modalEventName2.value = eventName;
      modalDescription.value = description;
      modalIsWorkdays.value = isWorkdays;
    })

    var deleteModal = document.getElementById('modal-danger');
    deleteModal.addEventListener('show.bs.modal', function (event) {
      // Button that triggered the modal
      var button = event.relatedTarget
      // Extract info from data-bs-* attributes
      var eventId = button.getAttribute('data-id');
      var eventUuid = button.getAttribute('data-uuid');

      var modalEventId = deleteModal.querySelector(".event-id");
      var modalEventUuid = deleteModal.querySelector(".event-uuid");
      modalEventId.value = eventId;
      modalEventUuid.value = eventUuid;
    })

    let getMessageErrorDelete = "<%= messageErrorDelete %>";
    if(getMessageErrorDelete) {
      var errorDelereModal = new bootstrap.Modal(document.getElementById('modal-error'), {})
      errorDelereModal.toggle();
    }

    let allChk = document.querySelectorAll('.chk_is_workdays')

    allChk.forEach((checkbox) => { 
      checkbox.addEventListener('change', (event) => {
        //let txtChk = document.getElementById('is_workdays');
        let txtChkEdit = editModal.querySelector(".is_workdays");
        let txtChkAdd = addModal.querySelector(".is_workdays");
        if (event.target.checked) {
          txtChkAdd.value = 1;
          txtChkEdit.value = 1;
          event.target.value = 1;
        } else {
          txtChkAdd.value = 0;
          txtChkEdit.value = 0;
          event.target.value = 0;
        }
      })
    })
  </script>
</body>
</html>
