                        <% } %> -->
                        <% if (i % 2 == 0) { %>
                        <% icon = 'ti-photo'; color = 'bg-twitter'; %>
                        <% } else { %>
                        <% icon = 'ti-briefcase'; color = 'bg-success'; %>
                        <% } %>
                        <i class="ti <%=icon %>"></i>
                      </div>
                      <div class="list-timeline-content">
                        <div class="list-timeline-time"><%=  moment(data.eventDate).format('DD-MMM-yyyy') %></div>
                        <p class="list-timeline-title"><%= data.eventName %></p>
                        <% if (data.is_workdays == 1) { %>
                          <p class="text-muted">Workday</p>
                        <% } else { %>
                          <p style="color: red;">Holiday</p>
                        <% } %>
                        <% if (data.description != null) { %>
                        <p class="text-muted"><%= String(data.description).substring(0, 200) %></p>
                        <% } %>
                      </div>
                    </li>
                    <% i++; %>
                    <% }); %>  

