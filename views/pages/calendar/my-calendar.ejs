                        <% icon = 'ti-briefcase'; color = 'bg-red';  %>
                        <% } else if (i == 3) { %>
                        <% icon = 'ti-brand-facebook'; color = 'bg-blue';  %>
                        <% } else if (i == 4) { %>
                        <% icon = 'ti-check'; color = 'bg-success';  %>
                        <% } else if (i == 5) { %>
