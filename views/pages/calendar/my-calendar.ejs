                </div>
                <div class="card-body">
                  <ul class="list list-timeline">
                    <% let i = 1; %>
                    <% let icon = ''; let color = ''; %>
                    <% listOfCalendar.forEach(function(data) { %>
                    <li>
                      <div class="list-timeline-icon <%= color %>"><!-- Download SVG icon from http://tabler-icons.io/i/brand-twitter -->
                        <!-- SVG icon code -->
                        <!--
                        <% if (i == 1) { %>
                        <% icon = 'ti-brand-twitter'; color = 'bg-twitter'; %>
