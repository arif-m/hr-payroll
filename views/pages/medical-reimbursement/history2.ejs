<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('./../layouts/head'); %>
</head>
<body>
  <div class="page">
    <aside class="navbar navbar-vertical navbar-expand-lg navbar-dark">
      <%- include('./../layouts/side'); %>
    </aside>
    <%- include('./../layouts/header1'); %>
  
    <div class="page-wrapper">
      <div class="container-xl">
        <%- include('./../layouts/header2'); %>
      </div>
      <div class="page-body">
        <div class="container-xl">
          <div class="row row-deck row-cards">
            <div class="col-12">
              <div class="card">
                  <div class="card-header">
                    <h3 class="card-title">Data Listing</h3>
                  </div>
                  <div class="card-body border-bottom py-3">
                    <div class="card-body">
                      <div class="row col-6">                                        
                        <div class="col-lg-12">
                          <div class="form-group mb-3 row">
                              <label class="form-label col-3 col-form-label">Budget</label>
                              <div class="col-6">
                                <input style="text-align: right;" type="text" class="form-control" name="budget" id="budget" value="<%= String(getDataEmployee.medicalReimbursementBudget).replace(/(.)(?=(\d{3})+$)/g,'$1,')  %>" disabled>
                              </div>
                          </div>
                        </div> 
                        <div class="col-lg-12">
                          <div class="form-group mb-3 row">
                            <label class="form-label col-3 col-form-label">Taken</label>
                            <div class="col-6">
                              <input style="text-align: right;" type="text" class="form-control" name="total_2" id="total_2" value="<%= String(getDataEmployee.medicalReimbursementTaken).replace(/(.)(?=(\d{3})+$)/g,'$1,')  %>" disabled>
                            </div>
                          </div>
                        </div>                        
                        <div class="col-lg-12">
                          <div class="form-group mb-3 row">
                            <label class="form-label col-3 col-form-label">Remaining</label>
                            <div class="col-6">
                              <input style="text-align: right;" type="text" class="form-control" name="remaining" id="remaining" value="<%= String(getDataEmployee.medicalReimbursementRemaining).replace(/(.)(?=(\d{3})+$)/g,'$1,')  %>" disabled>
                            </div>
                          </div>
                        </div>                        
                      </div>   
                    </div>
                    
                    <form action="/medical-reimbursement-history/<%= uuid %>" id="frmSearch" type="GET">
                      <div class="d-flex">
                        <!--<div class="text-muted">
                        </div>
                        <div class="ms-auto text-muted">
                          <div class="input-group mb-2">
                            <input type="text" id="search" name="search" class="form-control form-control-sm" placeholder="search data" value="<% if(locals.search) { %><%= search  %><% } %>">
                            <button class="btn" type="submit">Go</button>
                          </div>
                        </div>-->
                    </form>
                  </div>

                  <div class="table-responsive">
                    <table class="table card-table table-vcenter text-nowrap datatable" id="mytable">
                      <thead>
                      <tr>
                        <th>Category</th>
                        <th>Date</th>
                        <th style="text-align: right">Total Request</th>
                        <th style="text-align: right">Total Approved</th>
                        <th></th>
                      </tr>
                      </thead>
                      <tbody>
                        <% listOfHistory.data.forEach(function(data) { %>
                          <tr>
                            <td><%= data.reimbursementCategory %></td>
                            <td><%= moment.utc(data.createdAt).format('DD-MM-YYYY') %></td>
                            <td style="text-align: right"><%= String(data.totalReimbursement).replace(/(.)(?=(\d{3})+$)/g,'$1,') %></td>
                            <td style="text-align: right"><%= String(data.totalReimbursementApproved).replace(/(.)(?=(\d{3})+$)/g,'$1,') %></td>
                            <td class="text-end">
                            </td>
                          </tr>
                        <% }); %>                       
                      </tbody>
                    </table>
                  </div>
                                    
                  
              </div>
            </div>
          </div>
        </div>
      </div>
      <footer class="footer footer-transparent d-print-none">
        <%- include('./../layouts/footer'); %>
      </footer>
    </div>
  </div>

  <!-- Tabler Core -->
  <script src="/assets/tabler/js/tabler.min.js"></script>
  <script src="/assets/tabler/js/demo.min.js"></script>

  <script type = "text/JavaScript">
  </script>
</body>
</html>
