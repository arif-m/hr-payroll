<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('./../layouts/head'); %>
</head>
<body onload="createTable()">  
  <div class="page">
    <aside class="navbar navbar-vertical navbar-expand-lg navbar-dark">
      <%- include('./../layouts/side'); %>
    </aside>
    <%- include('./../layouts/header1'); %>
  
    <div class="page-wrapper">
      <div class="container-xl">
        <%- include('./../layouts/header2'); %>
      </div>
      <div class="page-body">
        <div class="container-xl">
          <div class="row row-deck row-cards">
            <div class="col-12">
              <div class="card">
                <div class="card-header">
                  <h3 class="card-title">Data</h3>
                </div>                  
                <form action="/medical-reimbursement-approved-by-fa" method="POST" autocomplete="off">
                  <div class="card-body">
                    <div class="row">                
                      <div class="col-lg-6">
                        <div class="form-group mb-3 row">
                          <label class="form-label col-3 col-form-label">Description</label>
                          <div class="col-9">
                            <textarea class="form-control" name="description_header" disabled><%=getDataRequestMedicalReimbursementHeader.reimbursementDescription %></textarea>
                          </div>
                        </div>
                      </div>
                      <div class="col-lg-6">
                        <div class="form-group mb-3 row">
                            <label class="form-label col-3 col-form-label">Category</label>
                            <div class="col-9">
                              <input type="text" class="form-control" name="category_description" id="category_description" value="<%=getDataRequestMedicalReimbursementHeader.reimbursementCategory %>" disabled>
                          </div>
                        </div>
                      </div> 
                      <div class="col-lg-6">
                        <div class="form-group mb-3 row">
                          <label class="form-label col-3 col-form-label">Total</label>
                          <div class="col-9">
                            <input type="hidden" class="form-control" name="total" id="total" value="<%=getDataRequestMedicalReimbursementHeader.totalReimbursement %>">
                            <input type="text" class="form-control" name="total_2" id="total_2" value="<%=generalHelper.formatNumberWithCommas(getDataRequestMedicalReimbursementHeader.totalReimbursement) %>" disabled>
                          </div>
                        </div>
                      </div>
                      <div class="col-lg-6">
                        <div class="form-group mb-3 row">
                          <label class="form-label col-3 col-form-label">Balance</label>
                          <div class="col-9">
                            <input type="hidden" class="form-control" name="balance" id="balance" value="<%= employeeData.medicalReimbursementRemaining %>">
                            <input type="text" class="form-control" name="balance2" id="balance2" value="<%= generalHelper.formatNumberWithCommas(employeeData.medicalReimbursementRemaining) %>" disabled>
                          </div>
                        </div>
                      </div>
                      <div class="col-lg-6">
                        <div class="form-group mb-3 row">
                            <label class="form-label col-3 col-form-label">Full Name</label>
                            <div class="col-9">
                              <input type="hidden" name="uuid" id="uuid" class="uuid" value="<%= getDataRequestMedicalReimbursementHeader.uuid %>">
                              <input type="hidden" name="employee_id" id="employee_id" class="employee-id" value="<%= employeeData.id %>" >
                              <input type="text" class="form-control full-name" name="full_name" id="full_name" value="<%= employeeData.fullName %>" disabled>
                            </div>
                        </div>
                      </div> 
                      <div class="col-lg-6">
                        <div class="form-group mb-3 row">
                          <label class="form-label col-3 col-form-label">Division</label>
                          <div class="col-9">
                            <input type="text" class="form-control" name="division" id="division" value="<%=getDataRequestMedicalReimbursementHeader.divisionName %>" disabled>
                          </div>
                        </div>
                      </div>
                      <div class="col-lg-6">
                        <div class="form-group mb-3 row">
                            <label class="form-label col-3 col-form-label">Created Date</label>
                            <div class="col-9">
                              <input type="text" class="form-control created-date" name="created_date" id="created_date" value="<%= moment(getDataRequestMedicalReimbursementHeader.createdAt).format('DD-MM-YYYY') %>" disabled>
                            </div>
                        </div>
                      </div>            
                      <div class="col-lg-6">
                        <div class="form-group mb-3 row">
                            <label class="form-label col-3 col-form-label">Is Approved ?</label>
                            <div class="col-9">
                              <select name="is_approved" id="is_approved" class="form-control is_approved" required>
                                  <option value="0">Open</option>
                                  <option value="1">Approved</option>
                                  <option value="2">Not Approved</option>                            
                              </select>
                            </div>
                        </div>
                      </div>   
                      <div class="col-lg-6">
                        <div class="form-group mb-3 row">
                            <label class="form-label col-3 col-form-label">Approved Date</label>
                            <div class="col-9">
                              <input type="hidden" class="form-control approved-date" placeholder="DD-MM-YYYY" name="approved_date" id="approved_date" value="<%= moment().format('DD-MM-yyyy'); %>">
                              <input type="text" class="form-control approved-date2" placeholder="DD-MM-YYYY" name="approved_date2" id="approved_date" value="<%= moment().format('DD-MM-yyyy'); %>" disabled>
                            </div>
                        </div>
                      </div>  
                      <div class="col-lg-6">
                        <div class="form-group mb-3 row">
                          <label class="form-label col-3 col-form-label">Total Approved</label>
                          <div class="col-9">
                            <input type="text" class="form-control total-approved" name="total_approved" id="total_approved" value="<%=getDataRequestMedicalReimbursementHeader.totalReimbursement %>">
                          </div>
                        </div>
                      </div>          
                      <div class="col-lg-6">
                        <div class="form-group mb-3 row">
                            <label class="form-label col-3 col-form-label">HR's Comments</label>
                            <div class="col-9">
                              <textarea class="form-control hr_comments" name="hr_comments" id="hr_comments" maxlength="300" disabled><%=getDataRequestMedicalReimbursementHeader.commentsByHR %></textarea>
                            </div>
                        </div>
                      </div>       
                      <div class="col-lg-6">
                        <div class="form-group mb-3 row">
                            <label class="form-label col-3 col-form-label">Comments</label>
                            <div class="col-9">
                              <textarea class="form-control comments" name="comments" id="comments" placeholder="Comments" maxlength="300"></textarea>
                            </div>
                        </div>
                      </div>       
                    </div>   
                  </div>
                  <div class="col-12">
                    <div class="card">
                      <div class="card-header">
                        <!--<h3 class="card-title">Details</h3>-->
                      </div> 
                      <div class="table-responsive">
                        <table class="table card-table table-vcenter text-nowrap datatable" id="mytable">
                          <thead>
                          <tr>
                              <th>No</th>
                              <th>Description</th>
                              <th style="text-align: center;">Amount</th>
                              <th></th>
                          </tr>
                          </thead>
                          <tbody>
                            <% index = 0; %>
                            <% getDataRequestMedicalReimbursementDetails.forEach(function(data) { %>
                            <% index++; %>
                              <tr>
                                  <td><span class="text-muted"><%=index; %></span></td>
                                  <td><%= data.detailsDescription %></td>
                                  <td style="text-align: right;"><%=generalHelper.formatNumberWithCommas(data.amount) %></td>
                              </tr>
                            <% }); %>    
                          </tbody>
                        </table>
                      </div>
                    </div>
                  </div>
                  <div class="card-footer">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button id="submit" class="btn btn-primary ms-auto" type="submit">
                      Submit
                    </button>
                    <a href="/medical-reimbursement-approved-by-fa/listing" class="btn btn-secondary">Back</a>
                  </div>
                </form>
              </div>
            </div>
          </div>
        </div>
      </div>
      <footer class="footer footer-transparent d-print-none">
        <%- include('./../layouts/footer'); %>
      </footer>
    </div>
  </div>

  <div class="modal modal-blur fade" id="modal-success" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-sm modal-dialog-centered" role="document">
      <div class="modal-content">
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        <div class="modal-status bg-success"></div>
        <div class="modal-body text-center py-4">
          <!-- Download SVG icon from http://tabler-icons.io/i/circle-check -->
          <svg xmlns="http://www.w3.org/2000/svg" class="icon mb-2 text-green icon-lg" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><circle cx="12" cy="12" r="9" /><path d="M9 12l2 2l4 -4" /></svg>
          <h3><%= message.success %></h3>
        </div>
        <div class="modal-footer">
          <div class="w-100">
            <div class="row">
              <div class="col">
                <a href="#" class="btn btn-success w-100" data-bs-dismiss="modal">
                  OK
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="modal modal-blur fade" id="modal-error" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-sm modal-dialog-centered" role="document">
      <div class="modal-content">
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        <div class="modal-status bg-danger"></div>
        <div class="modal-body text-center py-4">
          <!-- Download SVG icon from http://tabler-icons.io/i/circle-check -->
          <svg xmlns="http://www.w3.org/2000/svg" class="icon mb-2 text-danger icon-lg" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M12 9v2m0 4v.01" /><path d="M5 19h14a2 2 0 0 0 1.84 -2.75l-7.1 -12.25a2 2 0 0 0 -3.5 0l-7.1 12.25a2 2 0 0 0 1.75 2.75" /></svg>
          <h3><%= message.error %></h3>
        </div>
        <div class="modal-footer">
          <div class="w-100">
            <div class="row">
              <div class="col">
                <a href="#" class="btn btn-danger w-100" data-bs-dismiss="modal">
                  Close
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Tabler Core -->
  <script src="/assets/tabler/js/tabler.min.js"></script>
  <script src="/assets/tabler/js/demo.min.js"></script>
  
  <% var messageSuccess = message.success; %>
  <% var messageError = message.error; %>
  <script>
    let getMessageSuccess = "<%= messageSuccess %>";
    if(getMessageSuccess) {
      var successModal = new bootstrap.Modal(document.getElementById('modal-success'), {})
      successModal.toggle();
    }

    let getMessageError = "<%= messageError %>";
    if(getMessageError) {
      var errorDelereModal = new bootstrap.Modal(document.getElementById('modal-error'), {})
      errorDelereModal.toggle();
    }

  </script>
</body>
</html>
