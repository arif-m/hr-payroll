<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('./../layouts/head'); %>
</head>
<body>  
  <div class="page">
    <aside class="navbar navbar-vertical navbar-expand-lg navbar-dark">
      <%- include('./../layouts/side'); %>
    </aside>
    <%- include('./../layouts/header1'); %>
  
    <div class="page-wrapper">
      <div class="container-xl">
        <%- include('./../layouts/header2'); %>
      </div>
      <div class="page-body">
        <div class="container-xl">
          <div class="row row-deck row-cards">
            <div class="col-12">
              <div class="card">
                <div class="card-header">
                  <h3 class="card-title"><form action=""></form> All Employee or Selected Employee</h3>
                </div>      
                <form action="/salary-template/synchronize-component" method="POST">
                  <div class="card-body">
                    <div class="form-group mb-3 row">
                      <label class="form-label col-2 col-form-label">Component Name</label>
                      <div class="col-6">
                        <input type="text" class="form-control" name="salary_component_name" value="<%= getSalaryTemplate.component.componentName %>" disabled>
                        <input type="hidden" class="form-control"  name="salary_component_id" id="salary_component_id" value="<%= getSalaryTemplate.salaryComponentId %>" >
                        <input type="hidden" class="form-control"  name="uuid" id="uuid" value="<%= getSalaryTemplate.uuid %>" >
                        <input type="hidden" class="form-control"  name="salary_template_id" id="salary_template_id" value="<%= getSalaryTemplate.salaryTemplateId %>" >
                      </div>
                    </div>                    
                    <div class="form-group mb-3 row">
                      <label class="form-label col-2 col-form-label">Filter</label>
                      <div class="col-6">
                        <select name="selection_employee" id="selection_employee" class="form-control">
                          <option value="All">All Employee</option>
                          <option value="Selection">Selected Employee</option>
                        </select>
                      </div>
                    </div>                    
                    <div class="form-group mb-3 row" id="div_employee" style="display:none">
                      <label class="form-label col-2 col-form-label">Employee</label>
                      <div class="col-6">
                        <select name="employee" id="employee" class="form-control" multiple="true">
                          <% getEmployee.forEach(function(data) { %>
                            <option value="<%= data.id %>"><%= data.fullName %> - <%= data.email %></option>
                          <% }); %>
                        </select>
                      </div>
                    </div>                    
                  </div>
                  <div class="card-footer">
                    <input type="hidden" name="_csrf" id="_csrf" value="<%= csrfToken %>">
                    <button class="btn btn-outline-primary ms-auto syncronize" >Process</button>
                    <a href="#" onClick="history.go(-1); return false;" class="btn btn-secondary">Back</a>
                  </div>    
                </form>                        
              </div>
            </div>

          </div>
        </div>
      </div>
      <footer class="footer footer-transparent d-print-none">
        <%- include('./../layouts/footer'); %>
      </footer>
    </div>
  </div>

  <div class="modal modal-blur fade" id="modal-success" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-sm modal-dialog-centered" role="document">
      <div class="modal-content">
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        <div class="modal-status bg-success"></div>
        <div class="modal-body text-center py-4">
          <!-- Download SVG icon from http://tabler-icons.io/i/circle-check -->
          <svg xmlns="http://www.w3.org/2000/svg" class="icon mb-2 text-green icon-lg" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><circle cx="12" cy="12" r="9" /><path d="M9 12l2 2l4 -4" /></svg>
          <h3><%= message.success %></h3>
        </div>
        <div class="modal-footer">
          <div class="w-100">
            <div class="row">
              <div class="col">
                <a href="#" class="btn btn-success w-100" data-bs-dismiss="modal">
                  OK
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="modal modal-blur fade" id="modal-error" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-sm modal-dialog-centered" role="document">
      <div class="modal-content">
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        <div class="modal-status bg-danger"></div>
        <div class="modal-body text-center py-4">
          <!-- Download SVG icon from http://tabler-icons.io/i/circle-check -->
          <svg xmlns="http://www.w3.org/2000/svg" class="icon mb-2 text-danger icon-lg" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M12 9v2m0 4v.01" /><path d="M5 19h14a2 2 0 0 0 1.84 -2.75l-7.1 -12.25a2 2 0 0 0 -3.5 0l-7.1 12.25a2 2 0 0 0 1.75 2.75" /></svg>
          <h3><%= message.error %></h3>
        </div>
        <div class="modal-footer">
          <div class="w-100">
            <div class="row">
              <div class="col">
                <a href="#" class="btn btn-danger w-100" data-bs-dismiss="modal">
                  Close
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Tabler Core -->
  <script src="/assets/tabler/js/tabler.min.js"></script>
  <script src="/assets/tabler/js/demo.min.js"></script>
  <link href="https://cdn.jsdelivr.net/npm/tom-select@2.0.2/dist/css/tom-select.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/tom-select@2.0.2/dist/js/tom-select.complete.min.js"></script>

  <% var messageSuccess = message.success; %>
  <% var messageError = message.error; %>
  <script>
    var ctrlEmployee = new TomSelect("#employee",{
      //create: true,
      sortField: {
        field: "text",
        direction: "asc"
      },  
    });

    document.getElementById('selection_employee').addEventListener('change', function() {
      if (this.value == 'All') {
        const divEmployee = document.getElementById('div_employee');
        divEmployee.style.display = 'none';
      } else if (this.value == 'Selection') {
        const divEmployee = document.getElementById('div_employee');
        divEmployee.style.display = '';
      } 
    });

    let getMessageSuccess = "<%= messageSuccess %>";
    if(getMessageSuccess) {
      var successModal = new bootstrap.Modal(document.getElementById('modal-success'), {})
      successModal.toggle();
    }

    let getMessageError = "<%= messageError %>";
    if(getMessageError) {
      var errorModal = new bootstrap.Modal(document.getElementById('modal-error'), {})
      errorModal.toggle();
    }
  </script>
</body>
</html>
