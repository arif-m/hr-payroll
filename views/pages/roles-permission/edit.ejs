<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('./../layouts/head'); %>
</head>
<body>  
  <div class="page">
    <aside class="navbar navbar-vertical navbar-expand-lg navbar-dark">
      <%- include('./../layouts/side'); %>
    </aside>
    <%- include('./../layouts/header1'); %>
  
    <div class="page-wrapper">
      <div class="container-xl">
        <%- include('./../layouts/header2'); %>
      </div>
      <div class="page-body">
        <div class="container-xl">
          <div class="row row-deck row-cards">
            <div class="col-12">
              <div class="card">
                <div class="card-header">
                  <h3 class="card-title">Data Details</h3>
                </div>
                <form action="/roles-permission/update" method="POST" id="rpForm">
                  <div class="card-body">
                    <div class="form-group mb-3 row">
                      <label class="form-label col-2 col-form-label">Role Name</label>
                      <div class="col-3">
                        <input type="text" class="form-control" value="<%= roleName %>" disabled>
                        <input type="hidden" class="form-control" value="<%= roleId %>" name="roleId">
                      </div>
                    </div>

                    <div class="mb-2 small text-muted">
                      Centang hak pada <strong>modul induk</strong> untuk menerapkannya ke semua submenu di bawahnya
                      (cabangnya terbuka otomatis). Memberi hak pada submenu otomatis mengaktifkan <strong>Read</strong> pada induknya.
                      Mematikan <strong>Read</strong> induk menghapus seluruh hak submenu di bawahnya — centang ulang induk untuk membatalkan.
                      Gunakan ikon ▾ di nama induk untuk membuka/menutup daftar submenu kapan saja.
                    </div>

                    <div class="table-responsive">
                      <table class="table card-table table-vcenter text-nowrap" id="rpTable">
                        <thead>
                        <tr>
                          <th style="width: 34%">Feature Name</th>
                          <th class="text-center">Read</th>
                          <th class="text-center">Create</th>
                          <th class="text-center">Update</th>
                          <th class="text-center">Delete</th>
                          <th class="text-center">Inactive</th>
                        </tr>
                        </thead>
                        <tbody>
                          <% listOfRolesPermission.forEach(function(data) { %>
                            <%
                              var depth = rpDepth[data.id] || 0;
                              var descCount = rpDescendants[data.id] || 0;
                              var isParent = descCount > 0;
                            %>
                            <tr class="rp-row" data-module-id="<%= data.id %>" data-parent-id="<%= data.parentId || 0 %>" data-feature="<%= data.feature %>">
                              <td>
                                <% if (isParent) { %>
                                  <a href="#" class="rp-toggle-tree text-decoration-none" title="Klik untuk buka/tutup submenu"
                                     style="margin-left: <%= depth * 20 %>px; display: inline-block; padding-left: <%= depth > 0 ? 6 : 0 %>px;">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-sm rp-caret" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M6 9l6 6l6 -6" /></svg>
                                    <strong><%= data.feature %></strong>
                                  </a>
                                <% } else { %>
                                  <span style="display: inline-block; margin-left: <%= (depth * 20) + 24 %>px;">
                                    <%= data.feature %>
                                  </span>
                                <% } %>
                                <input type="hidden" value="<%= data.uuid %>" name="uuid">
                                <input type="hidden" value="<%= data.id %>" name="moduleId">
                                <input type="hidden" value="<%= data.treeStatus %>" name="treeStatus">

                                <input type="hidden" value="<%= data.createRight || 0 %>" name="createRight" data-module-id="<%= data.id %>">
                                <input type="hidden" value="<%= data.readRight || 0 %>" name="readRight" data-module-id="<%= data.id %>">
                                <input type="hidden" value="<%= data.updateRight || 0 %>" name="updateRight" data-module-id="<%= data.id %>">
                                <input type="hidden" value="<%= data.deleteRight || 0 %>" name="deleteRight" data-module-id="<%= data.id %>">
                                <input type="hidden" value="<%= data.inactiveRight || 0 %>" name="inactiveRight" data-module-id="<%= data.id %>">
                              </td>
                              <td class="text-center">
                                <input type="checkbox" class="rp-toggle" data-module-id="<%= data.id %>" data-right="read"
                                       value="<%= data.readRight || 0 %>" <% if (data.readRight == 1) { %> checked <% }; %>>
                              </td>
                              <td class="text-center">
                                <input type="checkbox" class="rp-toggle" data-module-id="<%= data.id %>" data-right="create"
                                       value="<%= data.createRight || 0 %>" <% if (data.createRight == 1) { %> checked <% }; %>>
                              </td>
                              <td class="text-center">
                                <input type="checkbox" class="rp-toggle" data-module-id="<%= data.id %>" data-right="update"
                                       value="<%= data.updateRight || 0 %>" <% if (data.updateRight == 1) { %> checked <% }; %>>
                              </td>
                              <td class="text-center">
                                <input type="checkbox" class="rp-toggle" data-module-id="<%= data.id %>" data-right="delete"
                                       value="<%= data.deleteRight || 0 %>" <% if (data.deleteRight == 1) { %> checked <% }; %>>
                              </td>
                              <td class="text-center">
                                <input type="checkbox" class="rp-toggle" data-module-id="<%= data.id %>" data-right="inactive"
                                       value="<%= data.inactiveRight || 0 %>" <% if (data.inactiveRight == 1) { %> checked <% }; %>>
                              </td>
                            </tr>
                          <% }); %>
                        </tbody>
                      </table>
                    </div>
                  </div>
                  <div class="card-footer">
                    <input type="hidden" name="_csrf" id="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="btn btn-primary">Save</button>
                    <a href="/roles-permission" class="btn btn-secondary">Close</a>
                  </div>
                </form>
              </div>
            </div>

          </div>
        </div>
      </div>
      <footer class="footer footer-transparent d-print-none">
        <%- include('./../layouts/footer'); %>
      </footer>
    </div>
  </div>
  
  <!-- Tabler Core -->
  <script src="/assets/tabler/js/tabler.min.js"></script>
  <script src="/assets/tabler/js/demo.min.js"></script>
  <script src="/js/roles-permission-tree.js"></script>
  <style>
    #rpTable .rp-toggle-tree { cursor: pointer; }
    #rpTable .rp-toggle-tree .rp-caret { transition: transform .15s ease; }
    #rpTable .rp-toggle-tree.collapsed .rp-caret { transform: rotate(-90deg); }
  </style>
</body>
</html>
