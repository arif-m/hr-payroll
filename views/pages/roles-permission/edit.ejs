                'Cache': 'no-cache',
                'X-CSRF-Token': csrf
              },
              body: data
          })
          .then(function(res){ 
            console.log('then1')
            //console.log(res);
            return res.json(); 
          })
          .then(function(data){ 
            console.log('then2')
            alert( JSON.stringify(data) )
          }) 
          */
/*
          
          (async () => {
            const rawResponse = await fetch('/roles-permission/update', {
              method: 'POST',
              headers: {
                'Accept': 'application/json',
                'Content-Type': 'application/json',
                'X-CSRF-Token': csrf
              },
              body: JSON.stringify(payload)
            });
            const content = await rawResponse.json();

            console.log(content);
          })();
*/
          //console.log(i);          
          //console.log(payload);
          payload = {};
          //return false;
        }
        alert('Save data');
        return false;
    }

    let allChkCreate = document.querySelectorAll('.create')

    allChkCreate.forEach((checkbox) => { 
      checkbox.addEventListener('change', (event) => {
        let txtCreate = document.getElementById('createRight_' + checkbox.getAttribute("data-id"));
        if (event.target.checked) {
          txtCreate.value = 1;
          event.target.value = 1;
        } else {
          txtCreate.value = 0;
          event.target.value = 0;
        }
      })
    })

    let allChkRead = document.querySelectorAll('.read')

    allChkRead.forEach((checkbox) => { 
      checkbox.addEventListener('change', (event) => {
        let txtRead = document.getElementById('readRight_' + checkbox.getAttribute("data-id"));
        if (event.target.checked) {
          txtRead.value = 1;
          event.target.value = 1;
        } else {
          txtRead.value = 0;
          event.target.value = 0;
        }
      })
    })

    let allChkUpdate = document.querySelectorAll('.update')

    allChkUpdate.forEach((checkbox) => { 
      checkbox.addEventListener('change', (event) => {
        let txtUpdate = document.getElementById('updateRight_' + checkbox.getAttribute("data-id"));
        if (event.target.checked) {
          txtUpdate.value = 1;
          event.target.value = 1;
        } else {
          txtUpdate.value = 0;
          event.target.value = 0;
        }
      })
    })

    let allChkDelete = document.querySelectorAll('.delete')

    allChkDelete.forEach((checkbox) => { 
      checkbox.addEventListener('change', (event) => {
        let txtDelete = document.getElementById('deleteRight_' + checkbox.getAttribute("data-id"));
        if (event.target.checked) {
          txtDelete.value = 1;
          event.target.value = 1;
        } else {
          txtDelete.value= 0;
          event.target.value = 0;
        }
      })
    })

    let allChkInactive = document.querySelectorAll('.inactive')

    allChkInactive.forEach((checkbox) => { 
      checkbox.addEventListener('change', (event) => {
        let txtInactive = document.getElementById('inactiveRight_' + checkbox.getAttribute("data-id"));
        if (event.target.checked) {
          txtInactive.value = 1;
          event.target.value = 1;
        } else {
          txtInactive.value = 0;
          event.target.value = 0;
        }
      })
    })
  </script>
</body>
</html>
