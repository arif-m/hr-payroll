<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('./../layouts/head'); %>
</head>
<body>  
  <div class="page">
    <aside class="navbar navbar-vertical navbar-expand-lg navbar-dark">
      <%- include('./../layouts/side'); %>
    </aside>
    <%- include('./../layouts/header1'); %>
  
    <div class="page-wrapper">
      <div class="container-xl">
        <%- include('./../layouts/header2'); %>
      </div>
      <div class="page-body">
        <div class="container-xl">
          <div class="row row-deck row-cards">
            <div class="col-12">
              <div class="card">
                <div class="card-header">
                  <h3 class="card-title">Edit Data </h3>
                </div> 
                <form action="/edit-salary-details/update" method="POST">                 
                  <div class="card-body">
                    <div class="row">
                      <div class="col-lg-6">
                        <div class="form-group mb-3 row">
                          <label class="form-label col-3 col-form-label">Full Name</label>
                          <div class="col-6">
                            <input type="text" class="form-control" name="full-name" value="<%= getPayslipHeader.fullName %>" disabled>
                            <input type="hidden" class="form-control"  name="uuid" id="uuid" value="<%= getPayslipHeader.uuid %>" >
                          </div>
                        </div>  
                      </div>
                      <div class="col-lg-6">
                        <div class="form-group mb-3 row">
                          <label class="form-label col-3 col-form-label">Organization</label>
                          <div class="col-6">
                            <input type="text" class="form-control" name="division" value="<%= getPayslipHeader.organization %>" disabled>
                          </div>
                        </div>
                      </div>
                      <div class="col-lg-6">
                        <div class="form-group mb-3 row">
                          <label class="form-label col-3 col-form-label">NPWP</label>
                          <div class="col-6">
                            <input type="text" class="form-control" name="npwp" value="<%= getPayslipHeader.npwp %>" disabled>
                          </div>
                        </div>
                      </div>
                      <div class="col-lg-6">
                        <div class="form-group mb-3 row">
                          <label class="form-label col-3 col-form-label">Job Titles</label>
                          <div class="col-6">
                            <input type="text" class="form-control" name="job_titles" value="<%= getPayslipHeader.jobTitle %>" disabled>
                          </div>
                        </div>
                      </div>
                    </div>

                    <table class="table card-table table-vcenter text-nowrap datatable" id="mytable">
                      <thead>
                      <tr>
                        <th>No.</th>
                        <th>Component Code</th>
                        <th>Component Name</th>
                        <th>Category</th>
                        <th>Amount</th>
                        <th></th>
                      </tr>
                      </thead>
                      <tbody>
                        <% no = 0; %>
                        <% listOfPayslipDetails.forEach(function(data) { %>
                        <% no++; %>
                        <tr>
                          <td>
                            <%= no %>
                          </td>
                          <td>
                            <%= data.code %>
                          </td>
                          <td>
                            <%= data.name %>
                          </td>
                          <td>
                            <%= data.category %>
                            <input type="hidden" class="form-control" name="uuid_details" value="<%= data.uuid %>">
                            <input type="hidden" class="form-control is-update" name="is_update" value="0">
                          </td>
                          <td>
                            <input type="text" class="form-control amt" name="amt" id="amount" value="<%= String(data.amount).replace(/(.)(?=(\d{3})+$)/g,'$1,') %>" data-id="<%= data.id %>" style="text-align: right;">
                          </td>
                          <td>
                            <!-- <button class="btn btn-outline-danger ms-auto delete" data-bs-toggle="modal" data-bs-target="#modal-danger" data-uuid="<%= data.uuid %>">Delete</button>-->
                          </td>
                        </tr>            
                        <% }); %>
                      </tbody>
                    </table>
                  </div>
                  <div class="card-footer">
                    <input type="hidden" name="_csrf" id="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="btn btn-primary">Save</button>
                    <a href="/edit-salary/<%= cutOfPeriodUuid %>" class="btn btn-secondary">Back</a>
                  </div>  
                </form>              
              </div>
            </div>

          </div>
        </div>
      </div>
      <footer class="footer footer-transparent d-print-none">
        <%- include('./../layouts/footer'); %>
      </footer>
    </div>
  </div>

  <div class="modal modal-blur fade" id="modal-success" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-sm modal-dialog-centered" role="document">
      <div class="modal-content">
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        <div class="modal-status bg-success"></div>
        <div class="modal-body text-center py-4">
          <!-- Download SVG icon from http://tabler-icons.io/i/circle-check -->
          <svg xmlns="http://www.w3.org/2000/svg" class="icon mb-2 text-green icon-lg" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><circle cx="12" cy="12" r="9" /><path d="M9 12l2 2l4 -4" /></svg>
          <h3><%= message.success %></h3>
        </div>
        <div class="modal-footer">
          <div class="w-100">
            <div class="row">
              <div class="col">
                <a href="#" class="btn btn-success w-100" data-bs-dismiss="modal">
                  OK
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Tabler Core -->
  <script src="/assets/tabler/js/tabler.min.js"></script>
  <script src="/assets/tabler/js/demo.min.js"></script>

  <% var messageSuccess = message.success; %>
  <script>
    let inputs = document.getElementsByClassName('amt');
    let results = document.getElementsByClassName('is-update');

    for(let i = 0; i < inputs.length; i++){
        inputs[i].addEventListener('keydown', () => {
          results[i].value = 1;
        });
        inputs[i].addEventListener('blur', () => {
          inputs[i].value = String(inputs[i].value).replace(/(.)(?=(\d{3})+$)/g,'$1,');
        });
        inputs[i].addEventListener('click', () => {
          inputs[i].value = Number(inputs[i].value.toString().replace(/\,/g,''));
        });
    }

    let getMessageSuccess = "<%= messageSuccess %>";
    if(getMessageSuccess) {
      var successModal = new bootstrap.Modal(document.getElementById('modal-success'), {})
      successModal.toggle();
    }
  </script>
</body>
</html>
