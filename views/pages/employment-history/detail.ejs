<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('./../layouts/head'); %>
</head>
<body>

  <div class="page">
    <aside class="navbar navbar-vertical navbar-expand-lg navbar-dark">
      <%- include('./../layouts/side'); %>
    </aside>
    <%- include('./../layouts/header1'); %>

    <div class="page-wrapper">
      <div class="container-xl">
        <%- include('./../layouts/header2'); %>
      </div>
      <div class="page-body">
        <div class="container-xl">
          <div class="row row-cards">
            <div class="col-12">
              <div class="card">
                <div class="card-header">
                  <h3 class="card-title">Riwayat Kepegawaian — <%= employee.fullName %> (<%= employee.employeeId.toString() %>)</h3>
                  <a href="/employment-history" class="btn btn-outline-secondary btn-sm ms-auto">&laquo; Kembali</a>
                </div>
                <div class="card-body border-bottom py-3">
                  <div class="row">
                    <div class="col-md-3"><span class="text-muted">Jabatan kini</span><div class="fw-bold"><%= employee.jobTitle ? employee.jobTitle.jobTitleName : '-' %></div></div>
                    <div class="col-md-3"><span class="text-muted">Divisi kini</span><div class="fw-bold"><%= employee.division ? employee.division.divisionName : '-' %></div></div>
                    <div class="col-md-3"><span class="text-muted">Status kini</span><div class="fw-bold"><%= employee.employmentStatus %></div></div>
                    <div class="col-md-3"><span class="text-muted">Tanggal masuk</span><div class="fw-bold"><%= moment(employee.joinDate).format('DD-MM-yyyy') %></div></div>
                  </div>
                </div>
                <div class="card-body border-bottom py-3">
                  <form method="GET" action="/employment-history/<%= employee.uuid %>" class="d-flex align-items-end">
                    <div class="me-2">
                      <label class="form-label">Hitung gaji berlaku pada tanggal</label>
                      <input type="date" name="as_of" class="form-control" value="<%= asOfInput %>" required>
                    </div>
                    <button class="btn btn-primary" type="submit">Hitung</button>
                    <% if (asOfInput) { %>
                      <a href="/employment-history/<%= employee.uuid %>" class="btn btn-outline-secondary ms-2">Reset</a>
                    <% } %>
                  </form>
                  <% if (asOfResult) { %>
                    <div class="alert alert-primary mt-3 mb-0" role="alert">
                      <strong>Gaji/jabatan berlaku per <%= asOfResult.date %>:</strong>
                      <%= asOfResult.jobTitleName || '-' %> — <%= asOfResult.divisionName || '-' %> (<%= asOfResult.employmentStatus || '-' %>),
                      PTKP <%= asOfResult.ptkpCode || '-' %>,
                      total penghasilan tetap <strong>Rp <%= asOfResult.totalFixed %></strong>
                      <details class="mt-1">
                        <summary class="text-muted" style="cursor:pointer;">Rincian komponen (<%= asOfResult.components.length %>)</summary>
                        <ul class="mb-0 mt-1">
                          <% asOfResult.components.forEach(function(c) { %>
                            <li><%= c.componentName %>: <%= generalHelper.formatNumberWithCommas(c.amount) %></li>
                          <% }); %>
                        </ul>
                      </details>
                    </div>
                  <% } %>
                </div>

                <div class="table-responsive">
                  <table class="table card-table table-vcenter text-nowrap" id="mytable">
                    <thead>
                    <tr>
                      <th>Tanggal Efektif</th>
                      <th>Jenis Perubahan</th>
                      <th>Jabatan</th>
                      <th>Divisi</th>
                      <th>Status</th>
                      <th>Penghasilan Tetap</th>
                      <th>Rincian / Alasan</th>
                      <th>Oleh</th>
                    </tr>
                    </thead>
                    <tbody>
                      <% timeline.forEach(function(row) { %>
                        <tr>
                          <td><%= moment(row.effectiveDate).format('DD-MM-yyyy') %></td>
                          <td><span class="badge <%= row.badge %>"><%= row.changeType %></span></td>
                          <td><%= row.jobTitleName || '-' %></td>
                          <td><%= row.divisionName || '-' %></td>
                          <td><%= row.employmentStatus || '-' %></td>
                          <td style="text-align: right;"><%= generalHelper.formatNumberWithCommas(row.totalFixed) %></td>
                          <td style="max-width: 420px; white-space: normal;">
                            <small>
                              <% if (row.componentsText) { %><%= row.componentsText %><% } %>
                              <% if (row.reason) { %><% if (row.componentsText) { %> &mdash; <% } %><em class="text-muted"><%= row.reason %></em><% } %>
                              <% if (!row.componentsText && !row.reason) { %>-<% } %>
                            </small>
                          </td>
                          <td><small class="text-muted"><%= row.createdBy %></small></td>
                        </tr>
                      <% }); %>
                      <% if (timeline.length === 0) { %>
                      <tr><td colspan="8" class="text-center text-muted py-4">Belum ada perubahan yang terekam.</td></tr>
                      <% } %>
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <footer class="footer footer-transparent d-print-none">
        <%- include('./../layouts/footer'); %>
      </footer>
    </div>
  </div>

  <script src="/assets/tabler/js/tabler.min.js"></script>
</body>
</html>
