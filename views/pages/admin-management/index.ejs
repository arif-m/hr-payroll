<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('./../layouts/head'); %>
</head>
<body>  
  <div class="page">
    <aside class="navbar navbar-vertical navbar-expand-lg navbar-dark">
      <%- include('./../layouts/side'); %>
    </aside>
    <%- include('./../layouts/header1'); %>
  
    <div class="page-wrapper">
      <div class="container-xl">
        <%- include('./../layouts/header2'); %>
      </div>
      <div class="page-body">
        <div class="container-xl">
          <div class="row row-deck row-cards">
            <div class="col-12">
              <div class="card">
                  <div class="card-header">
                    <h3 class="card-title">Data Listing</h3>
                  </div>
                  <div class="card-body border-bottom py-3">
                    <div class="col-12 mb-3">
                      <a href="/admin-management/search" class="btn btn-outline-primary ms-auto">
                        Add
                      </a>
                    </div>
                    <form action="/admin-management" id="frmSearch" type="GET">
                      <div class="d-flex">
                        <div class="text-muted">
                        Show
                        <div class="mx-2 d-inline-block">
                            <input type="text" class="form-control form-control-sm" value="<%= listOflistAdminManagement.meta.limit %>" size="3" aria-label="data count">
                        </div>
                        entries
                        </div>
                        <div class="ms-auto text-muted">
                          <div class="input-group mb-2">
                            <input type="text" id="search" name="search" class="form-control form-control-sm" placeholder="search data" value="<% if(locals.search) { %><%= search  %><% } %>">
                            <button class="btn" type="submit">Go</button>
                          </div>
                        </div>
                    </form>
                  </div>

                  <div class="table-responsive">
                    <table class="table card-table table-vcenter text-nowrap datatable" id="mytable">
                      <thead>
                      <tr>
                        <th class="w-1">Id. <!-- Download SVG icon from http://tabler-icons.io/i/chevron-up -->
                          <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-sm text-dark icon-thick" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><polyline points="6 15 12 9 18 15" /></svg>
                        </th>
                        <th>Emp Id</th>
                        <th>Name</th>
                        <th>Status</th>
                        <th>Role</th>
                        <th>Assign Date</th>
                        <th></th>
                      </tr>
                      </thead>
                      <tbody>
                        <% listOflistAdminManagement.data.forEach(function(employee) { %>
                          <tr>
                              <td><span class="text-muted"><%= employee.id %></span></td>
                              <td><%= employee.employeeId %></td>
                              <td><%= employee.fullName %></td>
                              <td><%= employee.status %></td>
                              <td><%= employee.role.roleName %></td>
                              <td><%= moment(employee.assignDate).format('DD-MM-YYYY') %></td>
                              <td class="text-end">
                                <!--<button class="btn btn-outline-primary ms-auto edit" data-bs-toggle="modal" data-bs-target="#modal-edit" data-id="<%= employee.id %>" data-uuid="<%= employee.uuid %>" data-full_name="<%= employee.fullName %>" >Assign</button>-->
                                <button class="btn btn-outline-danger ms-auto delete" data-bs-toggle="modal" data-bs-target="#modal-danger" data-id="<%= employee.id %>" data-uuid="<%= employee.uuid %>">Remove</button>
                              </td>
                          </tr>
                        <% }); %>                        
                      </tbody>
                    </table>
                  </div>
                                    
                  <div class="card-footer d-flex align-items-center">
                    <p class="m-0 text-muted">Showing <span>1</span> to <span><%= listOflistAdminManagement.meta.totalRecordCurrentPage %></span> of <span><%= listOflistAdminManagement.meta.totalRecords %></span> entries</p>
                    <% if (listOflistAdminManagement.meta.totalPage > 1) { %>
                    <ul class="pagination m-0 ms-auto">
                      <% if (listOflistAdminManagement.meta.currentPage == 0) { %>
                        <li class="page-item  disabled"><a class="btn btn-outline-primary ms-auto disabled btn-sm"><< First</a></li>&nbsp;
                      <% } else { %>
                          <li class="page-item"><a class="btn btn-outline-primary ms-auto inactive btn-sm" href="/admin-management?page=0&limit=<%= listOflistAdminManagement.meta.limit %>"><< First</a></li>&nbsp;
                      <% } %>
                      
                      <% if (listOflistAdminManagement.meta.currentPage == 0) { %>
                        <li class="page-item  disabled"><a class="btn btn-outline-primary ms-auto disabled btn-sm">< Prev</a></li>&nbsp;
                      <% } else { %>
                          <li class="page-item"><a class="btn btn-outline-primary ms-auto inactive btn-sm" href="/admin-management?page=<%= listOflistAdminManagement.meta.currentPage-1 %>&limit=<%= listOflistAdminManagement.meta.limit %>">< Previous</a></li>&nbsp;
                      <% } %>

                      <% if ((listOflistAdminManagement.meta.currentPage + 1) == listOflistAdminManagement.meta.totalPage) { %>
                        <li class="page-item  disabled"><a class="btn btn-outline-primary ms-auto disabled btn-sm">Next ></Next></a></li>&nbsp;
                      <% } else { %>
                          <li class="page-item"><a class="btn btn-outline-primary ms-auto inactive btn-sm" href="/admin-management?page=<%= listOflistAdminManagement.meta.currentPage+1 %>&limit=<%= listOflistAdminManagement.meta.limit %>"> Next ></a></li>&nbsp;
                      <% } %>

                      <% if (listOflistAdminManagement.meta.currentPage == (listOflistAdminManagement.meta.totalPage-1)) { %>
                        <li class="disabled"><a class="btn btn-outline-primary ms-auto disabled btn-sm">Last >></a></li>&nbsp;
                      <% } else { %>
                          <li><a class="btn btn-outline-primary ms-auto inactive btn-sm" href="/admin-management?page=<%= listOflistAdminManagement.meta.totalPage - 1 %>&limit=<%= listOflistAdminManagement.meta.limit %>">Last >></a></li>
                      <% } %>
                    </ul>
                    <% } %>
                  </div> 
              </div>
            </div>
          </div>
        </div>
      </div>
      <footer class="footer footer-transparent d-print-none">
        <%- include('./../layouts/footer'); %>
      </footer>
    </div>
  </div>
  
  <div class="modal modal-blur fade" id="modal-edit" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Assign Admin</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <form id="frmEdit" class="card card-md" method="POST" action="/admin-management/assign"  autocomplete="off">
          <div class="modal-body">
            <div class="row">
                <div class="col-lg-6">
                    <div class="mb-3">
                        <label class="form-label">Full Name</label>
                        <input type="hidden" name="employee_id" id="employee_id" class="employee-id" >
                        <input type="hidden" name="employee_uuid" id="employee_uuid" class="employee-uuid" >
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <input type="text" class="form-control full-name" name="full_name" id="full_name" placeholder="Name of Employee" required>
                    </div>   
                </div>     
                <div class="col-lg-6">
                  <div class="mb-3">
                      <label class="form-label">Join Date</label>
                      <input type="text" class="form-control join-date" placeholder="DD-MM-YYYY" name="join_date_edit" id="join_date_edit" required>
                  </div>
                </div>            
                <div class="col-lg-6">
                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input type="text" class="form-control email" name="email" id="email" placeholder="Email" required>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="mb-3">
                        <label class="form-label">Role</label>
                        <input type="hidden" class="form-control role-name" name="role_name" id="role_name" placeholder="role name" required>
                        <select name="role" id="role" class="form-control role" required>
                            <% listOfRoles.forEach(function(role) { %>
                            <option value="<%= role.id %>"
                              <% if(role.id == 2){ %>
                                selected
                              <% } %>
                            >
                              <%= role.roleName %></option>
                            <% }); %>
                        </select>
                    </div>
                </div>   
            </div>
          </div>
        
          <div class="modal-footer">
            <a href="#" class="btn btn-link link-secondary" data-bs-dismiss="modal">
              Cancel
            </a>
            <button id="updateBtn" class="btn btn-primary ms-auto" type="submit">
              Assign
            </button>
          </div>
        </form>
    </div>
    </div>
  </div>

  <div class="modal modal-blur fade" id="modal-danger" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-sm modal-dialog-centered" role="document">
      <div class="modal-content">
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        <div class="modal-status bg-danger"></div>
        <form class="card card-md" method="POST" action="/admin-management/remove" autocomplete="off">
          <div class="modal-body text-center py-4">
            <!-- Download SVG icon from http://tabler-icons.io/i/alert-triangle -->
            <svg xmlns="http://www.w3.org/2000/svg" class="icon mb-2 text-danger icon-lg" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M12 9v2m0 4v.01" /><path d="M5 19h14a2 2 0 0 0 1.84 -2.75l-7.1 -12.25a2 2 0 0 0 -3.5 0l-7.1 12.25a2 2 0 0 0 1.75 2.75" /></svg>
            <h3>Are you sure?</h3>
            <div class="text-muted">Do you really want to remove the data? What you've done cannot be undone.</div>
            <input type="hidden" name="employee_uuid" id="employee_uuid" class="employee-uuid" >
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          </div>
          <div class="modal-footer">
            <div class="w-100">
              <div class="row">
                <div class="col"><a href="#" class="btn w-100" data-bs-dismiss="modal">
                    Cancel
                  </a>
                </div>
                <button id="deleteBtn" class="col btn btn-danger ms-auto" type="submit" data-bs-dismiss="modal">
                  Remove Admin
                </button>
              </div>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
  
  <!-- Tabler Core -->
  <script src="/assets/tabler/js/tabler.min.js"></script>
  <script src="/assets/tabler/js/demo.min.js"></script>

  <!--<script src="https://cdnjs.cloudflare.com/ajax/libs/litepicker/2.0.11/litepicker.js" defer></script>-->
  <script src="/assets/tabler/libs/litepicker/dist/litepicker.js" ></script>
  <script type = "text/JavaScript">
    var editModal = document.getElementById('modal-edit');
    editModal.addEventListener('show.bs.modal', function (event) {
      // Button that triggered the modal
      var button = event.relatedTarget
      // Extract info from data-bs-* attributes
      var employeeId = button.getAttribute('data-id')
      var employeeUuid = button.getAttribute('data-uuid')
      var employeeName = button.getAttribute('data-full_name')
      // If necessary, you could initiate an AJAX request here
      // and then do the updating in a callback.
      //
      let url = '/employee/' + employeeUuid;
      //console.log(url);
      fetch(url)
        .then(res => res.json())
        .then(json => {
            //console.log(json);                
            let modalStatus= editModal.querySelector(".status");
            let modalRole = editModal.querySelector(".role");
            //let modalRoleName = editModal.querySelector(".role-name");
            let modalEmployeeUuid = editModal.querySelector(".employee-uuid");
            let modalId = editModal.querySelector(".employee-id");
            let modalEmployeeName = editModal.querySelector(".full-name");
            let modalJoinDate = editModal.querySelector(".join-date");
            let modalEmail = editModal.querySelector(".email");

            // Deserialize json because have BIG INT data type
            const jsonDeserialize = JSON.parse(json.data, (key, value) => {
                if (typeof value === "string" && value.startsWith('BIGINT::')) {
                    return BigInt(value.substr(8));
                }
                return value;
            });
            //console.log(jsonDeserialize);
            //console.log(jsonDeserialize.status);
            //return 'ok';

            modalRole.value = jsonDeserialize.role.id;
            //modalRoleName.value = jsonDeserialize.role.roleName;
            modalEmployeeUuid.value = jsonDeserialize.uuid;
            modalId.value = jsonDeserialize.id;
            modalEmployeeName.value = jsonDeserialize.fullName;

            let joinDate =  new Date(jsonDeserialize.joinDate);
            var dd = String(joinDate.getDate()).padStart(2, '0');
            var mm = String(joinDate.getMonth() + 1).padStart(2, '0'); //January is 0!
            var yyyy = joinDate.getFullYear();

            joinDate = yyyy + '/' + mm + '/' + dd ;
            modalJoinDate.value = joinDate;
            modalEmail.value = jsonDeserialize.email;
        })
    })

    var deleteModal = document.getElementById('modal-danger');
    deleteModal.addEventListener('show.bs.modal', function (event) {
        // Button that triggered the modal
        var button = event.relatedTarget
        // Extract info from data-bs-* attributes
        var employeeUuid = button.getAttribute('data-uuid')

        var modalEmployeeUuid = deleteModal.querySelector(".employee-uuid");
        modalEmployeeUuid.value = employeeUuid;
    })

    //on change role field
    const select = document.getElementById('role');
    select.addEventListener('change', function handleChange(event) {
      //console.log(event.target.value); // 👉️ get selected VALUE

      // 👇️ get selected VALUE even outside event handler
      //console.log(select.options[select.selectedIndex].value);

      // 👇️ get selected TEXT in or outside event handler
      //console.log(select.options[select.selectedIndex].text);

      let modalRoleName = editModal.querySelector(".role-name");
      modalRoleName.value = select.options[select.selectedIndex].text;

    });
  </script>
</body>
</html>
